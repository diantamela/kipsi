<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Factory Configuration -->
    <record id="view_coconut_factory_config_form" model="ir.ui.view">
        <field name="name">coconut.factory.config.form</field>
        <field name="model">coconut.factory.config</field>
        <field name="arch" type="xml">
            <form string="Coconut Factory Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                    </group>
                    <group string="Production Settings">
                        <field name="default_workcenter_id"/>
                        <field name="production_lead_time_days"/>
                    </group>
                    <group string="Inventory Locations">
                        <field name="coconut_receipt_location"/>
                        <field name="coconut_storage_location"/>
                        <field name="coconut_buffer_location"/>
                        <field name="finished_goods_location"/>
                    </group>
                    <group string="Purchase Settings">
                        <field name="default_purchase_approval_required"/>
                        <field name="auto_generate_po_from_requisition"/>
                    </group>
                    <group string="Quality Control">
                        <field name="auto_inspection_required"/>
                        <field name="inspection_approval_required"/>
                    </group>
                    <group string="HR Integration">
                        <field name="enable_hr_integration"/>
                        <field name="enable_payroll_integration"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Integration Menu Structure -->
    <menuitem id="menu_coconut_configuration" name="Configuration" parent="menu_coconut_root" sequence="100"/>
    <menuitem id="menu_coconut_factory_config" name="Factory Settings" 
              parent="menu_coconut_configuration" 
              action="action_coconut_factory_config" sequence="10"/>
    
    <!-- Action for factory config -->
    <record id="action_coconut_factory_config" model="ir.actions.act_window">
        <field name="name">Factory Configuration</field>
        <field name="res_model">coconut.factory.config</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>
</odoo>
