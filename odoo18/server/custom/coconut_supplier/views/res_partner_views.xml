<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search view for coconut partner -->
    <record id="view_coconut_supplier_search" model="ir.ui.view">
        <field name="name">coconut.supplier.search</field>
        <field name="model">coconut.supplier</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="coconut_supplier_type"/>
                <field name="quality_grade"/>
                <field name="province"/>
                <filter name="filter_premium" string="Premium Suppliers" 
                        domain="[('quality_grade', '=', 'premium')]"/>
                <filter name="filter_active" string="Active" 
                        domain="[('total_deliveries', '>', 0)]"/>
            </search>
        </field>
    </record>
</odoo>
