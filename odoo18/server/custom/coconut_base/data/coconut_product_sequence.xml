<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequences for Coconut Factory -->
    <record id="seq_coconut_batch" model="ir.sequence">
        <field name="name">Coconut Batch</field>
        <field name="code">coconut.batch</field>
        <field name="prefix">BATCH/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_coconut_inspection" model="ir.sequence">
        <field name="name">Coconut Inspection</field>
        <field name="code">coconut.inspection</field>
        <field name="prefix">INSP/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_coconut_purchase_requisition" model="ir.sequence">
        <field name="name">Coconut Purchase Requisition</field>
        <field name="code">coconut.purchase.requisition</field>
        <field name="prefix">REQ/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_coconut_production_order" model="ir.sequence">
        <field name="name">Coconut Production Order</field>
        <field name="code">coconut.production.order</field>
        <field name="prefix">PROD/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_coconut_work_order" model="ir.sequence">
        <field name="name">Coconut Work Order</field>
        <field name="code">coconut.work.order</field>
        <field name="prefix">WO/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_coconut_notification" model="ir.sequence">
        <field name="name">Coconut Notification</field>
        <field name="code">coconut.notification</field>
        <field name="prefix">NOTIF/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
