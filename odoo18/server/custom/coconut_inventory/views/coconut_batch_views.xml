<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Batch Views -->
    <record id="view_coconut_batch_tree_extend" model="ir.ui.view">
        <field name="name">coconut.batch.tree.extend</field>
        <field name="model">coconut.batch</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="batch_code"/>
                <field name="supplier_id"/>
                <field name="purchase_order_id"/>
                <field name="quantity_received"/>
                <field name="current_stock"/>
                <field name="inspection_completed"/>
                <field name="quality_state"/>
            </xpath>
        </field>
    </record>

    <record id="view_coconut_batch_form_extend" model="ir.ui.view">
        <field name="name">coconut.batch.form.extend</field>
        <field name="model">coconut.batch</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='tracking']" position="inside">
                <group>
                    <field name="batch_code"/>
                    <field name="supplier_id"/>
                    <field name="purchase_order_id"/>
                    <field name="purchase_line_id"/>
                </group>
                <group>
                    <field name="received_date" readonly="1"/>
                    <field name="received_by" readonly="1"/>
                    <field name="quantity_received" readonly="1"/>
                </group>
                <group>
                    <field name="inspection_required"/>
                    <field name="inspection_completed"/>
                    <field name="quality_state"/>
                    <field name="inspection_id"/>
                </group>
                <notebook>
                    <page string="Production Usage">
                        <field name="consumed_by_production" mode="tree,form">
                            <tree>
                                <field name="name"/>
                                <field name="product_qty"/>
                                <field name="state"/>
                                <field name="date_planned_start"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
