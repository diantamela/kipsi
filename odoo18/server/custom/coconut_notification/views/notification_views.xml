<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Notification Settings -->
    <record id="view_coconut_notification_settings_form" model="ir.ui.view">
        <field name="name">coconut.notification.settings.form</field>
        <field name="model">coconut.notification.settings</field>
        <field name="arch" type="xml">
            <form string="Coconut Notification Settings">
                <sheet>
                    <group>
                        <field name="company_id" readonly="1"/>
                    </group>
                    <group string="Stock Alerts">
                        <field name="enable_low_stock_alerts"/>
                        <field name="low_stock_threshold_days"/>
                        <field name="notify_stock_manager"/>
                        <field name="notify_purchase_manager"/>
                    </group>
                    <group string="Production Alerts">
                        <field name="enable_production_delay_alerts"/>
                        <field name="notify_production_manager"/>
                    </group>
                    <group string="Quality Alerts">
                        <field name="enable_quality_alerts"/>
                        <field name="rejection_threshold_percent"/>
                    </group>
                    <group string="Notification Recipients">
                        <field name="notification_recipients" widget="many2many_tags"/>
                        <field name="notification_frequency"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stock Alert Tree -->
    <record id="view_coconut_stock_alert_tree" model="ir.ui.view">
        <field name="name">coconut.stock.alert.tree</field>
        <field name="model">coconut.stock.alert</field>
        <field name="arch" type="xml">
            <tree string="Stock Alerts">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="current_stock"/>
                <field name="minimum_stock"/>
                <field name="alert_type"/>
                <field name="is_active"/>
                <field name="last_alert_date"/>
            </tree>
        </field>
    </record>

    <!-- Stock Alert Form -->
    <record id="view_coconut_stock_alert_form" model="ir.ui.view">
        <field name="name">coconut.stock.alert.form</field>
        <field name="model">coconut.stock.alert</field>
        <field name="arch" type="xml">
            <form string="Stock Alert">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="location_id"/>
                        <field name="current_stock" readonly="1"/>
                        <field name="minimum_stock"/>
                        <field name="maximum_stock"/>
                    </group>
                    <group>
                        <field name="alert_type" readonly="1"/>
                        <field name="is_active"/>
                    </group>
                    <group>
                        <field name="notify_users" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Notification Queue -->
    <record id="view_coconut_notification_queue_tree" model="ir.ui.view">
        <field name="name">coconut.notification.queue.tree</field>
        <field name="model">coconut.notification.queue</field>
        <field name="arch" type="xml">
            <tree string="Notification Queue">
                <field name="name"/>
                <field name="notification_type"/>
                <field name="priority"/>
                <field name="sent"/>
                <field name="sent_date"/>
                <field name="error_message"/>
            </tree>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_coconut_stock_alert_monitor" model="ir.actions.act_window">
        <field name="name">Stock Alerts</field>
        <field name="res_model">coconut.stock.alert</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <record id="action_coconut_notification_queue" model="ir.actions.act_window">
        <field name="name">Notification Queue</field>
        <field name="res_model">coconut.notification.queue</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_coconut_alerts" name="Alerts & Notifications" 
              parent="menu_coconut_root" sequence="60"/>
    <menuitem id="menu_coconut_stock_alerts" name="Stock Alerts" 
              parent="menu_coconut_alerts" action="action_coconut_stock_alert_monitor"/>
    <menuitem id="menu_coconut_notification_queue" name="Notification Queue" 
              parent="menu_coconut_alerts" action="action_coconut_notification_queue"/>

    <!-- Cron Job -->
    <record id="ir_cron_coconut_stock_monitor" model="ir.cron">
        <field name="name">Coconut Stock Level Monitor</field>
        <field name="model_id" ref="model_coconut_stock_monitor"/>
        <field name="code">model.check_all_stock_levels()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
