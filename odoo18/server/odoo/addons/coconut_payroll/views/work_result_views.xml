<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coconut_work_result_form" model="ir.ui.view">
        <field name="name">coconut.work.result.form</field>
        <field name="model">coconut.work.result</field>
        <field name="arch" type="xml">
            <form string="Hasil Kerja Pekerja">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,processed,paid"/>
                </header>
                <sheet>
                    <group>
                        <group string="Informasi Umum">
                            <field name="work_sheet_id" readonly="1"/>
                            <field name="date"/>
                            <field name="employee_id" readonly="state in ['processed', 'paid']"/>
                            <field name="worker_type" string="Jenis Pekerjaan"/>
                            <field name="day_type"/>
                        </group>
                        <group string="Perhitungan Hasil Kerja">
                            <field name="quantity_kg" readonly="state in ['processed', 'paid']"/>
                            <field name="wage_rate"/>
                            <field name="basic_wage"/>
                            <field name="premium"/>
                            <field name="total_wage"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="recap_line_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_coconut_work_result_list" model="ir.ui.view">
        <field name="name">coconut.work.result.list</field>
        <field name="model">coconut.work.result</field>
        <field name="arch" type="xml">
            <list string="Hasil Kerja Pekerja" decoration-info="state == 'draft'" decoration-success="state == 'validated'" decoration-muted="state in ['processed', 'paid']" create="false" edit="false">
                <field name="date"/>
                <field name="work_sheet_id"/>
                <field name="employee_id"/>
                <field name="worker_type" string="Jenis Pekerjaan"/>
                <field name="day_type"/>
                <field name="quantity_kg" sum="Total Qty"/>
                <field name="wage_rate"/>
                <field name="basic_wage" sum="Total Basic"/>
                <field name="premium" sum="Total Premium"/>
                <field name="total_wage" sum="Total Wage"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_coconut_work_result_search" model="ir.ui.view">
        <field name="name">coconut.work.result.search</field>
        <field name="model">coconut.work.result</field>
        <field name="arch" type="xml">
            <search string="Cari Hasil Kerja">
                <field name="worker_type"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Validated" name="validated" domain="[('state', '=', 'validated')]"/>
                <filter string="Processed" name="processed" domain="[('state', '=', 'processed')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Karyawan" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Jenis Pekerja" name="group_by_worker_type" context="{'group_by': 'worker_type'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Tanggal" name="group_by_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_coconut_work_result" model="ir.actions.act_window">
        <field name="name">Hasil Kerja Pekerja (Detil)</field>
        <field name="res_model">coconut.work.result</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_coconut_work_result_search"/>
    </record>
</odoo>
