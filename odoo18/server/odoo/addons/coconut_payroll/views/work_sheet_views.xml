<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coconut_work_sheet_form" model="ir.ui.view">
        <field name="name">coconut.work.sheet.form</field>
        <field name="model">coconut.work.sheet</field>
        <field name="arch" type="xml">
            <form string="Lembar Kerja Harian">
                <header>
                    <button name="action_validate" string="Validasi" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set ke Draft" type="object" invisible="state not in ['validated', 'cancelled']"/>
                    <button name="action_cancel" string="Batal" type="object" invisible="state in ['processed', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,processed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="worker_type" string="Jenis Pekerjaan" readonly="state != 'draft'"/>
                            <field name="day_type" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="transfer_id" readonly="state != 'draft'"/>
                            <field name="parer_source" readonly="state != 'draft'" invisible="worker_type != 'parer'" required="worker_type == 'parer'"/>
                            <field name="production_reference" readonly="state != 'draft'"/>
                            <field name="total_production_qty" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Hasil Kerja Pekerja" name="results">
                            <field name="work_result_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="quantity_kg"/>
                                    <field name="wage_rate" readonly="1" force_save="1"/>
                                    <field name="basic_wage" readonly="1" force_save="1"/>
                                    <field name="premium" readonly="1" force_save="1"/>
                                    <field name="total_wage" readonly="1" force_save="1"/>
                                    <field name="state" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_coconut_work_sheet_list" model="ir.ui.view">
        <field name="name">coconut.work.sheet.list</field>
        <field name="model">coconut.work.sheet</field>
        <field name="arch" type="xml">
            <list string="Lembar Kerja Harian" decoration-info="state == 'draft'" decoration-success="state == 'validated'" decoration-muted="state == 'processed'">
                <field name="name"/>
                <field name="date"/>
                <field name="worker_type" string="Jenis Pekerjaan"/>
                <field name="day_type"/>
                <field name="total_production_qty"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_coconut_work_sheet_search" model="ir.ui.view">
        <field name="name">coconut.work.sheet.search</field>
        <field name="model">coconut.work.sheet</field>
        <field name="arch" type="xml">
            <search string="Cari Lembar Kerja">
                <field name="name"/>
                <field name="worker_type"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Validated" name="validated" domain="[('state', '=', 'validated')]"/>
                <filter string="Processed" name="processed" domain="[('state', '=', 'processed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Tanggal" name="group_by_date" context="{'group_by': 'date'}"/>
                    <filter string="Jenis Pekerjaan" name="group_by_worker_type" context="{'group_by': 'worker_type'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_coconut_work_sheet" model="ir.actions.act_window">
        <field name="name">Hasil Kerja Harian</field>
        <field name="res_model">coconut.work.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_coconut_work_sheet_search"/>
    </record>
</odoo>
