<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Konfigurasi Penggajian" name="payroll_config">
                    <group>
                        <group string="Data Penggajian">
                            <field name="employee_code"/>
                            <field name="payroll_worker_type"/>
                            <field name="payroll_job_type"/>
                            <field name="status_karyawan"/>
                            <field name="tanggal_masuk"/>
                            <field name="payroll_active"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
