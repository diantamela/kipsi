<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coconut_payroll_premium_rule_form" model="ir.ui.view">
        <field name="name">coconut.payroll.premium.rule.form</field>
        <field name="model">coconut.payroll.premium.rule</field>
        <field name="arch" type="xml">
            <form string="Aturan Premi">
                <sheet>
                    <group>
                        <group string="Informasi Premi">
                            <field name="name"/>
                            <field name="worker_type"/>
                            <field name="minimum_quantity"/>
                            <field name="maximum_quantity"/>
                            <field name="premium_amount"/>
                        </group>
                        <group string="Konfigurasi Tambahan">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_coconut_payroll_premium_rule_list" model="ir.ui.view">
        <field name="name">coconut.payroll.premium.rule.list</field>
        <field name="model">coconut.payroll.premium.rule</field>
        <field name="arch" type="xml">
            <list string="Aturan Premi">
                <field name="name"/>
                <field name="worker_type"/>
                <field name="minimum_quantity"/>
                <field name="maximum_quantity"/>
                <field name="premium_amount"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_coconut_payroll_premium_rule" model="ir.actions.act_window">
        <field name="name">Aturan Premi</field>
        <field name="res_model">coconut.payroll.premium.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
