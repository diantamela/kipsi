<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Salary Rule Form View -->
    <record id="view_coconut_salary_rule_form" model="ir.ui.view">
        <field name="name">coconut.salary.rule.form</field>
        <field name="model">coconut.salary.rule</field>
        <field name="arch" type="xml">
            <form string="Aturan Upah Gaji">
                <sheet>
                    <group>
                        <group string="Kategori Pekerjaan">
                            <field name="worker_type"/>
                            <field name="day_type"/>
                        </group>
                        <group string="Batasan Kuantitas">
                            <field name="min_quantity"/>
                            <field name="max_quantity"/>
                        </group>
                        <group string="Masa Berlaku">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Tarif">
                            <field name="wage_rate"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Salary Rule Tree View -->
    <record id="view_coconut_salary_rule_list" model="ir.ui.view">
        <field name="name">coconut.salary.rule.list</field>
        <field name="model">coconut.salary.rule</field>
        <field name="arch" type="xml">
            <list string="Aturan Upah Gaji">
                <field name="worker_type"/>
                <field name="day_type"/>
                <field name="min_quantity"/>
                <field name="max_quantity"/>
                <field name="wage_rate"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Salary Rule Search View -->
    <record id="view_coconut_salary_rule_search" model="ir.ui.view">
        <field name="name">coconut.salary.rule.search</field>
        <field name="model">coconut.salary.rule</field>
        <field name="arch" type="xml">
            <search string="Cari Aturan Upah">
                <field name="worker_type"/>
                <field name="day_type"/>
                <group expand="0" string="Group By">
                    <filter string="Jenis Pekerja" name="group_by_worker" context="{'group_by': 'worker_type'}"/>
                    <filter string="Tipe Hari" name="group_by_day" context="{'group_by': 'day_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Salary Rule Action -->
    <record id="action_coconut_salary_rule" model="ir.actions.act_window">
        <field name="name">Aturan Upah</field>
        <field name="res_model">coconut.salary.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_coconut_salary_rule_search"/>
    </record>
</odoo>
