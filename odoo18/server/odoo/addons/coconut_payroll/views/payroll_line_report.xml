                                    <tr>
                                        <td>Hasil Kerja (<span t-field="o.total_quantity_kg"/> Kg)</td>
                                        <td class="text-end"><span t-field="o.basic_wage" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Premi / Bonus</td>
                                        <td class="text-end"><span t-field="o.premium" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    </tr>
                                    <tr>
                                        <td>&amp;nbsp;</td>
                                        <td>&amp;nbsp;</td>
                                    </tr>
                                    <tr>
                                        <td>&amp;nbsp;</td>
                                        <td>&amp;nbsp;</td>
                                    </tr>
                                    <tr>
                                        <td>&amp;nbsp;</td>
                                        <td>&amp;nbsp;</td>
                                    </tr>
                                </table>
                            </td>
                            <!-- Deductions Column -->
                            <td>
                                <table style="width: 100%; border: none;">
                                    <tr>
                                        <td>Potongan Pinjaman</td>
