                <!-- Header -->
                <table class="payslip-header-table">
                    <tr>
                        <td style="width: 20%; padding-bottom: 8px; vertical-align: middle;">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 70px; max-width: 100%; display: block;" alt="Logo"/>
                        </td>
                        <td style="width: 80%; padding-left: 15px; padding-bottom: 8px; vertical-align: middle; line-height: 1.4;">
                            <span t-field="o.company_id.name" style="font-size: 18px; font-weight: bold; display: block;"/><br/>
                            <span t-field="o.company_id.street"/><br/>
                            <span t-field="o.company_id.street2"/><br/>
                            <span t-field="o.company_id.city"/>, <span t-field="o.company_id.state_id.name"/> <span t-field="o.company_id.zip"/>
