                </div>
            </div>
        </div>
    </template>

    <!-- Daily (Harian) Reports Container Templates -->
    <template id="report_payslip_harian_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-call="coconut_payroll.payslip_harian_card"/>
                </t>
            </t>
        </t>
    </template>

    <!-- Piece-rate (Borongan) Reports Container Templates -->
    <template id="report_payslip_borongan_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-call="coconut_payroll.payslip_borongan_card"/>
                </t>
            </t>
        </t>
    </template>

    <!-- Unified Reports Container Template -->
    <template id="report_payslip_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-if="o.payroll_type == 'harian'">
                        <t t-call="coconut_payroll.payslip_harian_card"/>
                    </t>
                    <t t-else="">
                        <t t-call="coconut_payroll.payslip_borongan_card"/>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
