                                    </tr>
                                </table>
                            </td>
                            <td>
                                <table style="width: 100%; border: none;">
                                    <tr>
                                        <td><strong>TOTAL POTONGAN</strong></td>
                                        <td class="text-end"><strong><span t-field="o.loan_deduction" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Net Box -->
                <div class="payslip-net-box">
                    <table style="width: 100%; border: none; margin: 0;">
                        <tr>
                            <td>PENERIMAAN BERSIH (TAKE HOME PAY)</td>
                            <td class="text-end" style="font-size: 15px;"><span t-field="o.net_salary" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                        </tr>
                    </table>
                </div>

                <!-- Terbilang -->
                <div class="payslip-terbilang">
                    Terbilang : # <span t-out="o.currency_id.amount_to_text(o.net_salary)"/> #
                </div>

                <!-- Footer Signatures -->
                <table class="payslip-footer-signatures">
                    <tr>
                        <td>
                            Dibuat Oleh,<br/>
                            <span class="signature-line"/><br/>
                            <strong>Staf Payroll / HRD</strong>
                        </td>
                        <td>
                            Diketahui Oleh,<br/>
                            <span class="signature-line"/><br/>
                            <strong>Direktur</strong>
                        </td>
                        <td>
