<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Loan Form View -->
    <record id="view_coconut_employee_loan_form" model="ir.ui.view">
        <field name="name">coconut.employee.loan.form</field>
        <field name="model">coconut.employee.loan</field>
        <field name="arch" type="xml">
            <form string="Pinjaman Karyawan">
                <header>
                    <button name="action_active" string="Aktifkan" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set ke Draft" type="object" invisible="state not in ['active', 'cancelled']"/>
                    <button name="action_cancel" string="Batal" type="object" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,paid"/>
                </header>
                <sheet>
                    <group>
                        <group string="Informasi Pinjaman">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Nominal">
                            <field name="loan_amount" readonly="state != 'draft'"/>
                            <field name="installment_amount" readonly="state != 'draft'"/>
                            <field name="remaining_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Histori Cicilan" name="installments">
                            <field name="installment_line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="recap_line_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Employee Loan Tree View -->
    <record id="view_coconut_employee_loan_list" model="ir.ui.view">
        <field name="name">coconut.employee.loan.list</field>
        <field name="model">coconut.employee.loan</field>
        <field name="arch" type="xml">
            <list string="Pinjaman Karyawan" decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-muted="state == 'paid'">
                <field name="employee_id"/>
                <field name="loan_amount"/>
                <field name="installment_amount"/>
                <field name="remaining_amount"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Employee Loan Search View -->
    <record id="view_coconut_employee_loan_search" model="ir.ui.view">
        <field name="name">coconut.employee.loan.search</field>
        <field name="model">coconut.employee.loan</field>
        <field name="arch" type="xml">
            <search string="Cari Pinjaman">
                <field name="employee_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Aktif" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Lunas" name="paid" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Karyawan" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Employee Loan Action -->
    <record id="action_coconut_employee_loan" model="ir.actions.act_window">
        <field name="name">Pinjaman Karyawan</field>
        <field name="res_model">coconut.employee.loan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_coconut_employee_loan_search"/>
    </record>
</odoo>
