<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="coconut_receiving.CoconutDashboard" owl="1">
        <div class="o_coco_dashboard">
            <!-- Header section with title and optional manager button -->
            <div class="coco_dashboard_header d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="coco_title">Dashboard Produk Kelapa</h1>
                    <p class="coco_subtitle text-muted">Ringkasan stok real-time PT Coco Murni Prima Jaya</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary" t-on-click="loadData">
                        <i class="fa fa-refresh mr-1"/> Segarkan
                    </button>

                </div>
            </div>

            <!-- Loader -->
            <t t-if="state.loading">
                <div class="coco_loader d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                </div>
            </t>

            <!-- Cards Grid -->
            <t t-else="">
                <div class="row g-4 coco_grid">
                    <t t-foreach="state.products" t-as="prod" t-key="prod.code">
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card coco_card shadow-sm h-100" t-on-click="() => this.openProductStock(prod.code)">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <span class="badge bg-secondary mb-1"><t t-esc="prod.code"/></span>
                                            <h4 class="card-title product_title"><t t-esc="prod.name"/></h4>
                                        </div>
                                        <div class="coco_icon_wrapper">
                                            <i class="fa fa-archive text-primary"/>
                                        </div>
                                    </div>
                                    
                                    <div class="row text-center my-4">
                                        <div class="col-6 border-end">
                                            <div class="coco_metric_label">Stok Fisik</div>
                                            <div class="coco_metric_val text-success"><t t-esc="prod.qty"/> <small>Kg</small></div>
                                        </div>
                                        <div class="col-6">
                                            <div class="coco_metric_label">Stok Tersedia</div>
                                            <div class="coco_metric_val text-info"><t t-esc="prod.qty_available"/> <small>Kg</small></div>
                                        </div>
                                    </div>

                                    <div class="coco_details_list">
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted"><i class="fa fa-arrow-down text-success mr-1"/> Masuk Hari Ini</span>
                                            <span class="fw-bold"><t t-esc="prod.incoming_today"/> Kg</span>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted"><i class="fa fa-arrow-up text-danger mr-1"/> Keluar Hari Ini</span>
                                            <span class="fw-bold"><t t-esc="prod.outgoing_today"/> Kg</span>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted"><i class="fa fa-map-marker text-warning mr-1"/> Lokasi Stok</span>
                                            <span class="fw-bold text-truncate text-end" style="max-width: 150px;" t-att-title="prod.location_name">
                                                <t t-esc="prod.location_name"/>
                                            </span>
                                        </div>
                                        <div class="py-2">
                                            <div class="text-muted small mb-1"><i class="fa fa-history mr-1"/> Pergerakan Terakhir</div>
                                            <div class="small fw-bold text-truncate" t-att-title="prod.last_move">
                                                <t t-esc="prod.last_move"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
