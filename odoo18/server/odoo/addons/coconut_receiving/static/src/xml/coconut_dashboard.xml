<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="coconut_receiving.CoconutDashboard" owl="1">
        <div class="o_coco_dashboard p-4">
            <!-- Background Watermark Illustration -->
            <div class="coco_watermark"></div>

            <!-- Dashboard Sub-Header / Title -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center gap-3">
                    <span class="coco_dashboard_icon_wrapper">
                        <i class="fa fa-tachometer"></i>
                    </span>
                    <div>
                        <h2 class="coco_section_title m-0">Dashboard Operational RMP</h2>
                        <span class="text-muted small">Pusat Aktivitas Penerimaan &amp; Manajemen Stok Kelapa</span>
                    </div>
                </div>
                <div>
                    <button class="btn btn-light coco_refresh_btn border shadow-sm" t-on-click="loadData">
                        <i class="fa fa-refresh mr-1"></i> Segarkan Data
                    </button>
                </div>
            </div>

            <!-- Loading Spinner -->
            <t t-if="state.loading">
                <div class="text-center py-5">
                    <div class="spinner-border text-success" role="status">
                        <span class="visually-hidden">Memuat data dashboard...</span>
                    </div>
                    <p class="mt-2 text-muted">Memuat data operational RMP...</p>
                </div>
            </t>

            <t t-else="">
                <!-- Section 1: KPI Cards (6 Grid Columns: 2 rows of 3 or 6 col layout) -->
                <div class="row g-3 mb-4">
                    <!-- KPI 1: Kelapa Masuk Hari Ini -->
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                        <div class="card coco_kpi_card border-0 shadow-sm rounded-3 h-100" t-on-click="() => this.openAction('coconut_receiving.action_coconut_receipt')">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start">
                                    <span class="coco_kpi_label text-muted small fw-bold">Kelapa Masuk (Hari Ini)</span>
                                    <div class="coco_kpi_icon bg-success-subtle text-success p-2 rounded-circle">
                                        <i class="fa fa-truck fa-lg"></i>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <h4 class="coco_kpi_value text-dark fw-bold m-0"><t t-esc="formatNumber(state.kpi.kelapa_masuk_hari_ini)"/> <small class="fs-6 fw-normal text-muted">Kg</small></h4>
                                    <span class="coco_kpi_subtext text-success small"><i class="fa fa-check-circle me-1"></i>Penerimaan Hari Ini</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 2: Total Stok Kelapa -->
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                        <div class="card coco_kpi_card border-0 shadow-sm rounded-3 h-100" t-on-click="openStockReport">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start">
                                    <span class="coco_kpi_label text-muted small fw-bold">Total Stok Kelapa</span>
                                    <div class="coco_kpi_icon bg-primary-subtle text-primary p-2 rounded-circle">
                                        <i class="fa fa-cubes fa-lg"></i>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <h4 class="coco_kpi_value text-dark fw-bold m-0"><t t-esc="formatNumber(state.kpi.total_stok_kelapa)"/> <small class="fs-6 fw-normal text-muted">Kg</small></h4>
                                    <span class="coco_kpi_subtext text-primary small"><i class="fa fa-archive me-1"></i>Stok Kelapa Bulat</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 3: Supplier Hari Ini -->
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                        <div class="card coco_kpi_card border-0 shadow-sm rounded-3 h-100" t-on-click="openSuppliers">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start">
                                    <span class="coco_kpi_label text-muted small fw-bold">Supplier Hari Ini</span>
                                    <div class="coco_kpi_icon bg-info-subtle text-info p-2 rounded-circle">
                                        <i class="fa fa-users fa-lg"></i>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <h4 class="coco_kpi_value text-dark fw-bold m-0"><t t-esc="formatNumber(state.kpi.supplier_hari_ini)"/> <small class="fs-6 fw-normal text-muted">Supplier</small></h4>
                                    <span class="coco_kpi_subtext text-info small"><i class="fa fa-handshake-o me-1"></i>Pengirim Aktif</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 4: Purchase Order Pending -->
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                        <div class="card coco_kpi_card border-0 shadow-sm rounded-3 h-100" t-on-click="openPurchaseOrders">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start">
                                    <span class="coco_kpi_label text-muted small fw-bold">PO Pending</span>
                                    <div class="coco_kpi_icon bg-warning-subtle text-warning p-2 rounded-circle">
                                        <i class="fa fa-file-text-o fa-lg"></i>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <h4 class="coco_kpi_value text-dark fw-bold m-0"><t t-esc="formatNumber(state.kpi.purchase_order_pending)"/> <small class="fs-6 fw-normal text-muted">Dokumen</small></h4>
                                    <span class="coco_kpi_subtext text-warning small"><i class="fa fa-clock-o me-1"></i>Draft / Sent PO</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 5: Transfer Pending -->
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                        <div class="card coco_kpi_card border-0 shadow-sm rounded-3 h-100" t-on-click="openInternalTransfers">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start">
                                    <span class="coco_kpi_label text-muted small fw-bold">Transfer Pending</span>
                                    <div class="coco_kpi_icon bg-secondary-subtle text-secondary p-2 rounded-circle">
                                        <i class="fa fa-exchange fa-lg"></i>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <h4 class="coco_kpi_value text-dark fw-bold m-0"><t t-esc="formatNumber(state.kpi.transfer_pending)"/> <small class="fs-6 fw-normal text-muted">Transfer</small></h4>
                                    <span class="coco_kpi_subtext text-secondary small"><i class="fa fa-random me-1"></i>Pergerakan Stok</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 6: Receiving Pending -->
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                        <div class="card coco_kpi_card border-0 shadow-sm rounded-3 h-100" t-on-click="() => this.openAction('coconut_receiving.action_coconut_receipt')">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start">
                                    <span class="coco_kpi_label text-muted small fw-bold">Receiving Pending</span>
                                    <div class="coco_kpi_icon bg-danger-subtle text-danger p-2 rounded-circle">
                                        <i class="fa fa-hourglass-half fa-lg"></i>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <h4 class="coco_kpi_value text-dark fw-bold m-0"><t t-esc="formatNumber(state.kpi.receiving_pending)"/> <small class="fs-6 fw-normal text-muted">Draft</small></h4>
                                    <span class="coco_kpi_subtext text-danger small"><i class="fa fa-exclamation-circle me-1"></i>Belum Divalidasi</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Shortcuts / Quick Actions Bar (11 Operational Menus) -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center mb-3">
                            <i class="fa fa-bolt text-warning me-2 fs-5"></i>
                            <h5 class="coco_card_title m-0 fw-bold">Pintas Pintar (Quick Actions Operasional)</h5>
                        </div>
                        <div class="row g-2">
                            <!-- 1. Dashboard -->
                            <div class="col-6 col-md-3 col-lg-2 col-xl-1">
                                <button class="btn btn-outline-success w-100 py-2 d-flex flex-column align-items-center justify-content-center border-2 coco_shortcut_btn h-100" t-on-click="openDashboard">
                                    <i class="fa fa-tachometer fa-xl mb-1"></i>
                                    <span class="fw-semibold small text-center">Dashboard</span>
                                </button>
                            </div>
                            <!-- 2. Penerimaan Kelapa -->
                            <div class="col-6 col-md-3 col-lg-2 col-xl-1">
                                <button class="btn btn-outline-success w-100 py-2 d-flex flex-column align-items-center justify-content-center border-2 coco_shortcut_btn h-100" t-on-click="openReceipts">
                                    <i class="fa fa-truck fa-xl mb-1"></i>
                                    <span class="fw-semibold small text-center">Penerimaan</span>
                                </button>
                            </div>
                            <!-- 3. Sortir Kelapa -->
                            <div class="col-6 col-md-3 col-lg-2 col-xl-1">
                                <button class="btn btn-outline-primary w-100 py-2 d-flex flex-column align-items-center justify-content-center border-2 coco_shortcut_btn h-100" t-on-click="openSorting">
                                    <i class="fa fa-filter fa-xl mb-1"></i>
                                    <span class="fw-semibold small text-center">Sortir</span>
                                </button>
                            </div>
                            <!-- 4. Transfer Kelapa ke Produksi -->
                            <div class="col-6 col-md-3 col-lg-2 col-xl-1">
                                <button class="btn btn-outline-primary w-100 py-2 d-flex flex-column align-items-center justify-content-center border-2 coco_shortcut_btn h-100" t-on-click="openManufacturing">
                                    <i class="fa fa-cogs fa-xl mb-1"></i>
                                    <span class="fw-semibold small text-center">Transfer Produksi</span>
                                </button>
                            </div>
                            <!-- 5. Stok Kelapa -->
                            <div class="col-6 col-md-3 col-lg-2 col-xl-1">
                                <button class="btn btn-outline-info w-100 py-2 d-flex flex-column align-items-center justify-content-center border-2 coco_shortcut_btn h-100" t-on-click="openStockReport">
                                    <i class="fa fa-cubes fa-xl mb-1"></i>
                                    <span class="fw-semibold small text-center">Stok Kelapa</span>
                                </button>
                            </div>
                            <!-- 6. Produk Kelapa -->
                            <div class="col-6 col-md-3 col-lg-2 col-xl-1">
                                <button class="btn btn-outline-info w-100 py-2 d-flex flex-column align-items-center justify-content-center border-2 coco_shortcut_btn h-100" t-on-click="openProducts">
                                    <i class="fa fa-tags fa-xl mb-1"></i>
                                    <span class="fw-semibold small text-center">Produk Kelapa</span>
                                </button>
                            </div>
                            <!-- 7. Transfer Internal -->
                            <div class="col-6 col-md-3 col-lg-2 col-xl-1">
                                <button class="btn btn-outline-secondary w-100 py-2 d-flex flex-column align-items-center justify-content-center border-2 coco_shortcut_btn h-100" t-on-click="openInternalTransfers">
                                    <i class="fa fa-exchange fa-xl mb-1"></i>
                                    <span class="fw-semibold small text-center">Transfer Internal</span>
                                </button>
                            </div>
                            <!-- 8. Stock Adjustment -->
                            <div class="col-6 col-md-3 col-lg-2 col-xl-1">
                                <button class="btn btn-outline-secondary w-100 py-2 d-flex flex-column align-items-center justify-content-center border-2 coco_shortcut_btn h-100" t-on-click="openStockAdjustment">
                                    <i class="fa fa-sliders fa-xl mb-1"></i>
                                    <span class="fw-semibold small text-center">Stock Adjustment</span>
                                </button>
                            </div>
                            <!-- 9. Purchase Order -->
                            <div class="col-6 col-md-3 col-lg-2 col-xl-1">
                                <button class="btn btn-outline-warning w-100 py-2 d-flex flex-column align-items-center justify-content-center border-2 coco_shortcut_btn h-100" t-on-click="openPurchaseOrders">
                                    <i class="fa fa-shopping-cart fa-xl mb-1"></i>
                                    <span class="fw-semibold small text-center">Purchase Order</span>
                                </button>
                            </div>
                            <!-- 10. Supplier -->
                            <div class="col-6 col-md-3 col-lg-2 col-xl-1">
                                <button class="btn btn-outline-warning w-100 py-2 d-flex flex-column align-items-center justify-content-center border-2 coco_shortcut_btn h-100" t-on-click="openSuppliers">
                                    <i class="fa fa-address-book fa-xl mb-1"></i>
                                    <span class="fw-semibold small text-center">Supplier</span>
                                </button>
                            </div>
                            <!-- 11. Laporan -->
                            <div class="col-6 col-md-3 col-lg-2 col-xl-1">
                                <button class="btn btn-outline-dark w-100 py-2 d-flex flex-column align-items-center justify-content-center border-2 coco_shortcut_btn h-100" t-on-click="openReports">
                                    <i class="fa fa-file-text-o fa-xl mb-1"></i>
                                    <span class="fw-semibold small text-center">Laporan</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Monitoring Stok (Kanban Produk Kelapa) -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center">
                                <i class="fa fa-archive text-success me-2 fs-5"></i>
                                <h5 class="coco_card_title m-0 fw-bold">Monitoring Stok Real-Time (Produk Kelapa)</h5>
                            </div>
                            <button class="btn btn-sm btn-outline-success" t-on-click="openProducts">
                                <i class="fa fa-external-link me-1"></i> Kelola Produk
                            </button>
                        </div>
                        <div class="row g-3">
                            <t t-if="state.coconut_products_stock &amp;&amp; state.coconut_products_stock.length &gt; 0">
                                <t t-foreach="state.coconut_products_stock" t-as="p" t-key="p.name">
                                    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                                        <div class="card border border-light-subtle shadow-sm rounded-3 h-100 coco_stock_card" t-on-click="() => this.openProductRecord(p.product_id)">
                                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                                <div>
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <h6 class="fw-bold text-dark mb-0 text-truncate" t-att-title="p.name"><t t-esc="p.name"/></h6>
                                                        <span t-attf-class="badge rounded-pill {{ p.status_code == 'aman' ? 'bg-success' : (p.status_code == 'normal' ? 'bg-warning text-dark' : 'bg-danger') }}">
                                                            <t t-esc="p.status_label"/>
                                                        </span>
                                                    </div>
                                                    <div class="coco_stock_qty my-2">
                                                        <h3 class="fw-bold text-dark m-0"><t t-esc="formatNumber(p.qty)"/> <small class="fs-6 fw-normal text-muted"><t t-esc="p.uom"/></small></h3>
                                                    </div>
                                                </div>
                                                <div class="border-top pt-2 mt-2">
                                                    <div class="d-flex justify-content-between align-items-center text-muted small" style="font-size: 11px;">
                                                        <span class="text-truncate me-1" t-att-title="p.location"><i class="fa fa-map-marker me-1"></i><t t-esc="p.location"/></span>
                                                    </div>
                                                    <div class="text-muted small mt-1" style="font-size: 10px;">
                                                        <i class="fa fa-clock-o me-1"></i>Update: <t t-esc="p.last_update"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="col-12 text-center py-4 text-muted small">
                                    Memuat data stok produk kelapa...
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Section 4: Charts Row -->
                <div class="row g-4 mb-4">
                    <!-- Chart 1: Kelapa Masuk 7 Hari Terakhir -->
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="coco_card_title m-0 fw-bold"><i class="fa fa-line-chart text-success me-2"></i>Kelapa Masuk 7 Hari Terakhir</h5>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">7 Hari</span>
                                </div>
                                <div class="coco_chart_container position-relative py-3" style="height: 240px;">
                                    <div class="d-flex align-items-end justify-content-around h-100 pt-4 px-2 border-bottom">
                                        <t t-foreach="state.charts.receiving_7_days" t-as="item" t-key="item.day_name">
                                            <div class="d-flex flex-column align-items-center flex-grow-1 h-100 justify-content-end px-1">
                                                <span class="small fw-bold text-success mb-1" style="font-size: 11px;"><t t-esc="formatNumber(item.qty)"/></span>
                                                <div class="bg-success rounded-top w-100 coco_bar_hover" 
                                                     t-attf-style="height: {{ item.qty &gt; 0 ? Math.min(100, Math.max(15, Math.round((item.qty / (Math.max(...state.charts.receiving_7_days.map(d =&gt; d.qty) || [1])) * 160)))) : 4 }}px; min-height: 4px; transition: height 0.5s ease;">
                                                </div>
                                                <span class="small text-muted mt-2 fw-semibold" style="font-size: 11px;"><t t-esc="item.day_name"/></span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Chart 2: Pergerakan Stok Kelapa & Top Supplier -->
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="coco_card_title m-0 fw-bold"><i class="fa fa-pie-chart text-primary me-2"></i>Supplier Terbanyak Bulan Ini</h5>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Top 5 Supplier</span>
                                </div>
                                <div class="coco_top_suppliers_list d-flex flex-column gap-2 mt-3">
                                    <t t-if="state.charts.top_suppliers &amp;&amp; state.charts.top_suppliers.length &gt; 0">
                                        <t t-foreach="state.charts.top_suppliers" t-as="sup" t-key="sup.name">
                                            <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light border-start border-4 border-primary">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="fa fa-user-circle text-primary"></i>
                                                    <span class="fw-semibold text-dark small"><t t-esc="sup.name"/></span>
                                                </div>
                                                <span class="badge bg-primary text-white"><t t-esc="formatNumber(sup.qty)"/> Kg</span>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div class="text-center py-4 text-muted small">
                                            Belum ada transaksi supplier bulan ini.
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 5: Recent Activity Tables (4 Grid Columns) -->
                <div class="row g-4 mb-4">
                    <!-- Table 1: 10 Penerimaan Terakhir -->
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                                <h6 class="m-0 fw-bold text-dark"><i class="fa fa-truck text-success me-2"></i>Penerimaan Terakhir</h6>
                                <button class="btn btn-sm btn-link text-success p-0 text-decoration-none" t-on-click="openReceipts">Lihat Semua</button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle m-0 small">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Kode</th>
                                                <th>Supplier</th>
                                                <th class="text-end">Berat (Kg)</th>
                                                <th class="text-center">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="state.recent.receipts &amp;&amp; state.recent.receipts.length &gt; 0">
                                                <t t-foreach="state.recent.receipts" t-as="r" t-key="r.id">
                                                    <tr t-on-click="() => this.openReceiptRecord(r.id)" role="button" class="coco_table_row">
                                                        <td class="fw-semibold text-primary"><t t-esc="r.name"/></td>
                                                        <td><t t-esc="r.partner"/></td>
                                                        <td class="text-end fw-bold"><t t-esc="formatNumber(r.net_weight)"/></td>
                                                        <td class="text-center">
                                                            <span t-attf-class="badge rounded-pill {{ r.state == 'done' ? 'bg-success' : (r.state == 'draft' ? 'bg-warning text-dark' : 'bg-secondary') }}">
                                                                <t t-esc="r.state == 'done' ? 'Selesai' : (r.state == 'draft' ? 'Draft' : r.state)"/>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <tr>
                                                    <td colspan="4" class="text-center text-muted py-3">Belum ada penerimaan.</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Table 2: 10 Transfer Terakhir -->
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                                <h6 class="m-0 fw-bold text-dark"><i class="fa fa-exchange text-primary me-2"></i>Transfer Terakhir</h6>
                                <button class="btn btn-sm btn-link text-primary p-0 text-decoration-none" t-on-click="openInternalTransfers">Lihat Semua</button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle m-0 small">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Referensi</th>
                                                <th>Dari / Ke</th>
                                                <th class="text-center">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="state.recent.transfers &amp;&amp; state.recent.transfers.length &gt; 0">
                                                <t t-foreach="state.recent.transfers" t-as="t" t-key="t.id">
                                                    <tr t-on-click="() => this.openTransferRecord(t.id)" role="button" class="coco_table_row">
                                                        <td class="fw-semibold text-dark"><t t-esc="t.name"/></td>
                                                        <td>
                                                            <div class="text-truncate" style="max-width: 140px;" t-att-title="t.src + ' → ' + t.dest">
                                                                <t t-esc="t.src"/> → <t t-esc="t.dest"/>
                                                            </div>
                                                        </td>
                                                        <td class="text-center">
                                                            <span t-attf-class="badge rounded-pill {{ t.state == 'done' ? 'bg-success' : (t.state == 'assigned' ? 'bg-info text-white' : 'bg-warning text-dark') }}">
                                                                <t t-esc="t.state"/>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <tr>
                                                    <td colspan="3" class="text-center text-muted py-3">Belum ada transfer internal.</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Table 3: 10 Stock Adjustment Terakhir -->
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                                <h6 class="m-0 fw-bold text-dark"><i class="fa fa-sliders text-info me-2"></i>Stock Adjustment Terakhir</h6>
                                <button class="btn btn-sm btn-link text-info p-0 text-decoration-none" t-on-click="openStockAdjustment">Lihat Semua</button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle m-0 small">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Produk / Ref</th>
                                                <th>Lokasi</th>
                                                <th class="text-end">Jumlah</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="state.recent.adjustments &amp;&amp; state.recent.adjustments.length &gt; 0">
                                                <t t-foreach="state.recent.adjustments" t-as="adj" t-key="adj.id">
                                                    <tr t-on-click="openStockAdjustment" role="button" class="coco_table_row">
                                                        <td class="fw-semibold text-dark text-truncate" style="max-width: 110px;" t-att-title="adj.name"><t t-esc="adj.name"/></td>
                                                        <td class="text-truncate" style="max-width: 100px;" t-att-title="adj.location"><t t-esc="adj.location"/></td>
                                                        <td class="text-end fw-bold text-info"><t t-esc="formatNumber(adj.quantity)"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <tr>
                                                    <td colspan="3" class="text-center text-muted py-3">Belum ada stock adjustment.</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Table 4: Purchase Order Pending -->
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                                <h6 class="m-0 fw-bold text-dark"><i class="fa fa-shopping-cart text-warning me-2"></i>PO Pending</h6>
                                <button class="btn btn-sm btn-link text-warning p-0 text-decoration-none" t-on-click="openPurchaseOrders">Lihat Semua</button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle m-0 small">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Nomor PO</th>
                                                <th>Supplier</th>
                                                <th class="text-end">Total</th>
                                                <th class="text-center">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="state.recent.pos &amp;&amp; state.recent.pos.length &gt; 0">
                                                <t t-foreach="state.recent.pos" t-as="po" t-key="po.id">
                                                    <tr t-on-click="() => this.openPoRecord(po.id)" role="button" class="coco_table_row">
                                                        <td class="fw-semibold text-warning"><t t-esc="po.name"/></td>
                                                        <td><t t-esc="po.partner"/></td>
                                                        <td class="text-end fw-bold"><t t-esc="formatCurrency(po.amount_total)"/></td>
                                                        <td class="text-center">
                                                            <span class="badge rounded-pill bg-warning text-dark">
                                                                <t t-esc="po.state"/>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <tr>
                                                    <td colspan="4" class="text-center text-muted py-3">Tidak ada PO pending.</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
