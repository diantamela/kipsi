<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="coconut_receiving.CoconutDashboard" owl="1">
        <div class="o_coco_dashboard">
            <!-- Background Watermark Illustration -->
            <div class="coco_watermark"></div>

            <!-- Dashboard Sub-Header / Title -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="coco_dashboard_icon_wrapper">
                        <i class="fa fa-dashboard"></i>
                    </span>
                    <h2 class="coco_section_title m-0">Dashboard</h2>
                </div>
                <div>
                    <button class="btn btn-light coco_refresh_btn" t-on-click="loadData">
                        <i class="fa fa-refresh mr-1"></i> Segarkan
                    </button>
                </div>
            </div>

            <!-- KPI Cards Grid (4 Columns) -->
            <div class="row g-4 mb-4">
                <!-- KPI 1: Today's Coconut Receiving -->
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card coco_kpi_card" t-on-click="() => this.openAction('coconut_receiving.action_coconut_receipt')">
                        <div class="card-body d-flex align-items-center justify-content-between p-4">
                            <div>
                                <span class="coco_kpi_label">Penerimaan Kelapa</span>
                                <span class="coco_kpi_sublabel">Hari Ini</span>
                                <h3 class="coco_kpi_value mt-2"><t t-esc="formatNumber(state.metrics.receiving_qty)"/> Kg</h3>
                                <span class="coco_kpi_trend text-success"><i class="fa fa-arrow-up"></i> <t t-esc="state.metrics.receiving_count"/> penerimaan</span>
                            </div>
                            <div class="coco_kpi_icon_wrapper">
                                <i class="fa fa-cubes"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KPI 2: Today's Production -->
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card coco_kpi_card" t-on-click="() => this.openAction('coconut_receiving.action_coconut_manufacturing')">
                        <div class="card-body d-flex align-items-center justify-content-between p-4">
                            <div>
                                <span class="coco_kpi_label">Produksi</span>
                                <span class="coco_kpi_sublabel">Hari Ini</span>
                                <h3 class="coco_kpi_value mt-2"><t t-esc="formatNumber(state.metrics.production_qty)"/> Kg</h3>
                                <span class="coco_kpi_trend_sub">Kelapa Layak Produksi</span>
                            </div>
                            <div class="coco_kpi_icon_wrapper">
                                <i class="fa fa-industry"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KPI 3: Production Ready Stock -->
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card coco_kpi_card" t-on-click="() => this.openProductStock('COCO-LAYAK')">
                        <div class="card-body d-flex align-items-center justify-content-between p-4">
                            <div>
                                <span class="coco_kpi_label">Stok Kelapa Layak</span>
                                <span class="coco_kpi_sublabel">Produksi</span>
                                <h3 class="coco_kpi_value mt-2"><t t-esc="formatNumber(state.metrics.ready_stock_qty)"/> Kg</h3>
                                <span class="coco_kpi_trend_sub">Ready Production</span>
                            </div>
                            <div class="coco_kpi_icon_wrapper">
                                <i class="fa fa-database"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KPI 4: Active Employees -->
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card coco_kpi_card" t-on-click="() => this.openAction('hr.open_view_employee_list')">
                        <div class="card-body d-flex align-items-center justify-content-between p-4">
                            <div>
                                <span class="coco_kpi_label">Karyawan Aktif</span>
                                <span class="coco_kpi_sublabel">Shift Hari Ini</span>
                                <h3 class="coco_kpi_value mt-2"><t t-esc="formatNumber(state.metrics.active_employees)"/> Orang</h3>
                                <span class="coco_kpi_trend_sub">3 Shift</span>
                            </div>
                            <div class="coco_kpi_icon_wrapper">
                                <i class="fa fa-user-circle-o"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chart & Inventory Section -->
            <div class="row g-4 mb-4">
                <!-- Production Chart (2/3 width on large screens) -->
                <div class="col-12 col-lg-8">
                    <div class="card coco_dashboard_card h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h4 class="coco_card_title m-0"><i class="fa fa-line-chart me-2"></i>Produksi Kelapa Bulanan</h4>
                                <div class="coco_chart_filter">
                                    <button class="btn btn-sm btn-light">Tahun Ini <i class="fa fa-angle-down ms-1"></i></button>
                                </div>
                            </div>
                            
                            <!-- Responsive SVG Chart -->
                            <div class="coco_chart_container position-relative" style="height: 320px;">
                                <svg class="w-100 h-100" viewBox="0 0 800 300" preserveAspectRatio="none">
                                    <defs>
                                        <!-- Soft green gradient fill -->
                                        <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0%" stop-color="#4CAF50" stop-opacity="0.25"/>
                                            <stop offset="100%" stop-color="#E8F5E9" stop-opacity="0.0"/>
                                        </linearGradient>
                                    </defs>
                                    
                                    <!-- Horizontal Grid Lines -->
                                    <line x1="50" y1="20" x2="770" y2="20" stroke="#F1F3F5" stroke-width="1"/>
                                    <line x1="50" y1="60" x2="770" y2="60" stroke="#F1F3F5" stroke-width="1"/>
                                    <line x1="50" y1="100" x2="770" y2="100" stroke="#F1F3F5" stroke-width="1"/>
                                    <line x1="50" y1="140" x2="770" y2="140" stroke="#F1F3F5" stroke-width="1"/>
                                    <line x1="50" y1="180" x2="770" y2="180" stroke="#F1F3F5" stroke-width="1"/>
                                    <line x1="50" y1="220" x2="770" y2="220" stroke="#F1F3F5" stroke-width="1"/>
                                    <line x1="50" y1="260" x2="770" y2="260" stroke="#F1F3F5" stroke-width="1"/>
                                    
                                    <!-- Y-Axis Labels -->
                                    <text x="40" y="24" class="coco_chart_text text-end">60,000</text>
                                    <text x="40" y="64" class="coco_chart_text text-end">50,000</text>
                                    <text x="40" y="104" class="coco_chart_text text-end">40,000</text>
                                    <text x="40" y="144" class="coco_chart_text text-end">30,000</text>
                                    <text x="40" y="184" class="coco_chart_text text-end">20,000</text>
                                    <text x="40" y="224" class="coco_chart_text text-end">10,000</text>
                                    <text x="40" y="264" class="coco_chart_text text-end">0</text>
                                    
                                    <!-- Y-Axis Legend Label -->
                                    <text x="15" y="24" class="coco_chart_legend_y" transform="rotate(-90 15 24)">Kg</text>
                                    
                                    <!-- X-Axis Labels (Months) -->
                                    <text x="75" y="285" class="coco_chart_text text-center">Jan</text>
                                    <text x="135" y="285" class="coco_chart_text text-center">Feb</text>
                                    <text x="195" y="285" class="coco_chart_text text-center">Mar</text>
                                    <text x="255" y="285" class="coco_chart_text text-center">Apr</text>
                                    <text x="315" y="285" class="coco_chart_text text-center">Mei</text>
                                    <text x="375" y="285" class="coco_chart_text text-center">Jun</text>
                                    <text x="435" y="285" class="coco_chart_text text-center">Jul</text>
                                    <text x="495" y="285" class="coco_chart_text text-center">Agu</text>
                                    <text x="555" y="285" class="coco_chart_text text-center">Sep</text>
                                    <text x="615" y="285" class="coco_chart_text text-center">Okt</text>
                                    <text x="675" y="285" class="coco_chart_text text-center">Nov</text>
                                    <text x="735" y="285" class="coco_chart_text text-center">Des</text>

                                    <!-- Fill Area (Gradient) -->
                                    <path d="M 75 260 L 75 188 L 135 160 L 195 148 L 255 156 L 315 124 L 375 100 L 435 116 L 495 88 L 555 80 L 615 56 L 675 72 L 735 48 L 735 260 Z" fill="url(#chartGradient)"/>
                                    
                                    <!-- Line Path -->
                                    <path d="M 75 188 L 135 160 L 195 148 L 255 156 L 315 124 L 375 100 L 435 116 L 495 88 L 555 80 L 615 56 L 675 72 L 735 48" fill="none" stroke="#4CAF50" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                                    
                                    <!-- Dots on Points -->
                                    <circle cx="75" cy="188" r="4" fill="#2E7D32" stroke="#FFFFFF" stroke-width="2"/>
                                    <circle cx="135" cy="160" r="4" fill="#2E7D32" stroke="#FFFFFF" stroke-width="2"/>
                                    <circle cx="195" cy="148" r="4" fill="#2E7D32" stroke="#FFFFFF" stroke-width="2"/>
                                    <circle cx="255" cy="156" r="4" fill="#2E7D32" stroke="#FFFFFF" stroke-width="2"/>
                                    <circle cx="315" cy="124" r="4" fill="#2E7D32" stroke="#FFFFFF" stroke-width="2"/>
                                    <circle cx="375" cy="100" r="4" fill="#2E7D32" stroke="#FFFFFF" stroke-width="2"/>
                                    <circle cx="435" cy="116" r="4" fill="#2E7D32" stroke="#FFFFFF" stroke-width="2"/>
                                    <circle cx="495" cy="88" r="4" fill="#2E7D32" stroke="#FFFFFF" stroke-width="2"/>
                                    <circle cx="555" cy="80" r="4" fill="#2E7D32" stroke="#FFFFFF" stroke-width="2"/>
                                    <circle cx="615" cy="56" r="4" fill="#2E7D32" stroke="#FFFFFF" stroke-width="2"/>
                                    <circle cx="675" cy="72" r="4" fill="#2E7D32" stroke="#FFFFFF" stroke-width="2"/>
                                    <circle cx="735" cy="48" r="4" fill="#2E7D32" stroke="#FFFFFF" stroke-width="2"/>
                                </svg>
                            </div>
                            
                            <!-- Legend -->
                            <div class="d-flex justify-content-center mt-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="coco_legend_color"></span>
                                    <span class="coco_legend_label">Produksi (Kg)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Inventory Status Card (1/3 width on large screens) -->
                <div class="col-12 col-lg-4">
                    <div class="card coco_dashboard_card h-100">
                        <div class="card-body p-4">
                            <h4 class="coco_card_title mb-4"><i class="fa fa-cubes me-2"></i>Status Persediaan</h4>
                            
                            <div class="coco_inventory_list d-flex flex-column gap-3">
                                <!-- Kelapa Bulat -->
                                <div class="coco_inventory_item d-flex align-items-center justify-content-between p-3 rounded" t-on-click="() => this.openProductStock('COCO-BULAT')">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="coco_inv_icon_circle">
                                            <i class="fa fa-archive"></i>
                                        </div>
                                        <div>
                                            <h5 class="coco_inv_item_title m-0">Kelapa Bulat</h5>
                                            <span class="coco_inv_item_subtitle">Total Stok</span>
                                        </div>
                                    </div>
                                    <div class="coco_inv_qty_val text-success">
                                        <t t-esc="formatNumber(state.metrics.inventory.bulat)"/> <small>Kg</small>
                                    </div>
                                </div>

                                <!-- Kelapa Layak Produksi -->
                                <div class="coco_inventory_item d-flex align-items-center justify-content-between p-3 rounded" t-on-click="() => this.openProductStock('COCO-LAYAK')">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="coco_inv_icon_circle">
                                            <i class="fa fa-check-circle"></i>
                                        </div>
                                        <div>
                                            <h5 class="coco_inv_item_title m-0">Kelapa Layak Produksi</h5>
                                            <span class="coco_inv_item_subtitle">Siap Diproses</span>
                                        </div>
                                    </div>
                                    <div class="coco_inv_qty_val text-primary">
                                        <t t-esc="formatNumber(state.metrics.inventory.layak)"/> <small>Kg</small>
                                    </div>
                                </div>

                                <!-- Kelapa Reject -->
                                <div class="coco_inventory_item d-flex align-items-center justify-content-between p-3 rounded" t-on-click="() => this.openProductStock('COCO-REJECT')">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="coco_inv_icon_circle">
                                            <i class="fa fa-times-circle"></i>
                                        </div>
                                        <div>
                                            <h5 class="coco_inv_item_title m-0">Reject</h5>
                                            <span class="coco_inv_item_subtitle">Tidak Layak</span>
                                        </div>
                                    </div>
                                    <div class="coco_inv_qty_val text-danger">
                                        <t t-esc="formatNumber(state.metrics.inventory.reject)"/> <small>Kg</small>
                                    </div>
                                </div>

                                <!-- Parer -->
                                <div class="coco_inventory_item d-flex align-items-center justify-content-between p-3 rounded" t-on-click="() => this.openProductStock('COCO-PARER')">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="coco_inv_icon_circle">
                                            <i class="fa fa-tasks"></i>
                                        </div>
                                        <div>
                                            <h5 class="coco_inv_item_title m-0">Parrer</h5>
                                            <span class="coco_inv_item_subtitle">Stok Tersedia</span>
                                        </div>
                                    </div>
                                    <div class="coco_inv_qty_val text-warning">
                                        <t t-esc="formatNumber(state.metrics.inventory.parer)"/> <small>Kg</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Production & Payroll Status (Bottom Row) -->
            <div class="row g-4">
                <!-- Production Status Card -->
                <div class="col-12 col-md-6 col-lg-5">
                    <div class="card coco_dashboard_card h-100">
                        <div class="card-body p-4">
                            <h4 class="coco_card_title mb-4"><i class="fa fa-cog me-2"></i>Status Produksi</h4>
                            
                            <div class="row g-3 text-center">
                                <!-- MO Active -->
                                <div class="col-3">
                                    <div class="coco_status_box p-3 rounded">
                                        <div class="coco_status_icon text-primary"><i class="fa fa-clipboard"></i></div>
                                        <h3 class="coco_status_num mt-2"><t t-esc="state.metrics.production_status.mo_active"/></h3>
                                        <span class="coco_status_label">MO Aktif</span>
                                    </div>
                                </div>
                                <!-- MO Running -->
                                <div class="col-3">
                                    <div class="coco_status_box p-3 rounded">
                                        <div class="coco_status_icon text-warning"><i class="fa fa-refresh"></i></div>
                                        <h3 class="coco_status_num mt-2"><t t-esc="state.metrics.production_status.mo_running"/></h3>
                                        <span class="coco_status_label">Sedang Berjalan</span>
                                    </div>
                                </div>
                                <!-- Finished Today -->
                                <div class="col-3">
                                    <div class="coco_status_box p-3 rounded">
                                        <div class="coco_status_icon text-success"><i class="fa fa-check-square-o"></i></div>
                                        <h3 class="coco_status_num mt-2"><t t-esc="state.metrics.production_status.mo_finished_today"/></h3>
                                        <span class="coco_status_label">Selesai Hari Ini</span>
                                    </div>
                                </div>
                                <!-- Efficiency -->
                                <div class="col-3">
                                    <div class="coco_status_box p-3 rounded">
                                        <div class="coco_status_icon text-info"><i class="fa fa-tachometer"></i></div>
                                        <h3 class="coco_status_num mt-2"><t t-esc="state.metrics.production_status.efficiency"/>%</h3>
                                        <span class="coco_status_label">Efisiensi Produksi</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payroll Card -->
                <div class="col-12 col-md-6 col-lg-7">
                    <div class="card coco_dashboard_card h-100" t-on-click="() => this.openAction('om_hr_payroll.menu_hr_payroll_employees')">
                        <div class="card-body p-4">
                            <h4 class="coco_card_title mb-4"><i class="fa fa-users me-2"></i>Payroll Hari Ini</h4>
                            
                            <div class="row g-4 align-items-center">
                                <!-- Payroll Metrics -->
                                <div class="col-9">
                                    <div class="row text-center">
                                        <!-- Total Employees -->
                                        <div class="col-4 border-end">
                                            <span class="coco_payroll_lbl">Total Karyawan</span>
                                            <h3 class="coco_payroll_val mt-2"><t t-esc="formatNumber(state.metrics.payroll.total_employees)"/> Orang</h3>
                                            <span class="coco_payroll_sub">Karyawan Aktif</span>
                                        </div>
                                        <!-- Daily Wage -->
                                        <div class="col-4 border-end">
                                            <span class="coco_payroll_lbl">Upah Hari Ini</span>
                                            <h3 class="coco_payroll_val mt-2"><t t-esc="formatCurrency(state.metrics.payroll.daily_wage)"/></h3>
                                            <span class="coco_payroll_sub">Total Upah</span>
                                        </div>
                                        <!-- Production Bonus -->
                                        <div class="col-4">
                                            <span class="coco_payroll_lbl">Premi Produksi</span>
                                            <h3 class="coco_payroll_val mt-2"><t t-esc="formatCurrency(state.metrics.payroll.production_bonus)"/></h3>
                                            <span class="coco_payroll_sub">Total Premi</span>
                                        </div>
                                    </div>
                                </div>
                                <!-- Payroll Status (Badge Column) -->
                                <div class="col-3 text-center">
                                    <span class="coco_payroll_lbl">Status Payroll</span>
                                    <div class="coco_payroll_status_badge mt-2">
                                        <i class="fa fa-check-circle"></i>
                                        <span>Sudah Dihitung</span>
                                    </div>
                                    <span class="coco_payroll_sub mt-1 d-block">Siap Dibayarkan</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
