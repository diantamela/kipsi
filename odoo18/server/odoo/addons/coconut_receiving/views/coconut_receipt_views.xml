<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════
         Form View – coconut.receipt
         Tabs: Data Timbangan | Penilaian Kualitas | Detail Penerimaan | Lampiran | Pergerakan Stok
         ═══════════════════════════════════════════════════ -->
    <record id="view_coconut_receipt_form" model="ir.ui.view">
        <field name="name">coconut.receipt.form</field>
        <field name="model">coconut.receipt</field>
        <field name="arch" type="xml">
            <form string="Penerimaan Kelapa">
                <header>
                    <button name="action_validate"
                            id="btn_validate_receipt"
                            string="Validasi"
                            type="object"
                            invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_cancel"
                            id="btn_cancel_receipt"
                            string="Batalkan"
                            type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft"
                            id="btn_reset_receipt"
                            string="Kembalikan ke Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- ─── Header Info ─── -->
                    <group>
                        <group string="Informasi Umum">
                            <field name="partner_id"
                                   readonly="state == 'done'"/>
                            <field name="origin"
                                   string="Asal Kelapa"
                                   readonly="state == 'done'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Kendaraan &amp; Pengemudi">
                            <field name="driver_name"
                                   readonly="state == 'done'"/>
                            <field name="driver_phone"
                                   readonly="state == 'done'"/>
                            <field name="vehicle_plate"
                                   readonly="state == 'done'"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ─── Tab 1: Data Timbangan ─── -->
                        <page string="Data Timbangan" name="tab_timbangan">
                            <group>
                                <group string="Waktu">
                                    <field name="entry_datetime"
                                           string="Tanggal &amp; Waktu Masuk"
                                           readonly="state == 'done'"/>
                                    <field name="exit_datetime"
                                           string="Tanggal &amp; Waktu Keluar"
                                           readonly="state == 'done'"/>
                                </group>
                                <group string="Dokumen Administrasi">
                                    <field name="item_name"
                                           string="Nama Barang"
                                           readonly="state == 'done'"/>
                                    <field name="reference_number"
                                           string="Nomor Referensi"
                                           readonly="state == 'done'"/>
                                    <field name="npwp"
                                           string="NPWP"
                                           readonly="state == 'done'"/>
                                    <field name="pphd2"
                                           string="PPHD2"
                                           readonly="state == 'done'"/>
                                </group>
                            </group>
                            <group string="Data Penimbangan">
                                <group string="Berat Kendaraan">
                                    <field name="gross_vehicle_weight"
                                           string="Berat Kotor Kendaraan (Kg)"
                                           readonly="state == 'done'"/>
                                    <field name="tare_vehicle_weight"
                                           string="Berat Tara Kendaraan (Kg)"
                                           readonly="state == 'done'"/>
                                    <field name="pot_weight"
                                           string="Berat Wadah/Pot (Kg)"
                                           readonly="state == 'done'"/>
                                </group>
                                <group string="Hasil Penimbangan">
                                    <field name="net_received_weight"
                                           string="Berat Bersih Diterima (Kg)"
                                           readonly="1"
                                           class="o_field_highlight"/>
                                    <field name="total_count"
                                           string="Jumlah Kelapa (Butir)"
                                           readonly="state == 'done'"/>
                                    <field name="avg_weight_per_coconut"
                                           string="KG per Butir"
                                           readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- ─── Tab 2: Penilaian Kualitas ─── -->
                        <page string="Penilaian Kualitas" name="tab_kualitas">
                            <group>
                                <group string="Penilaian">
                                    <field name="quality_grade"
                                           string="Nilai Kualitas"
                                           readonly="state == 'done'"/>
                                    <field name="avg_quality"
                                           string="Rata-rata Kualitas"
                                           readonly="state == 'done'"/>
                                </group>
                            </group>
                            <group string="Catatan Kualitas">
                                <field name="quality_notes"
                                       nolabel="1"
                                       readonly="state == 'done'"/>
                            </group>
                        </page>

                        <!-- ─── Tab 3: Detail Penerimaan ─── -->
                        <page string="Detail Penerimaan" name="tab_detail">
                            <group>
                                <group string="Personel">
                                    <field name="receiving_employee_id"
                                           string="Karyawan Penerima"
                                           readonly="state == 'done'"/>
                                    <field name="administrator_id"
                                           string="Administrator"
                                           readonly="state == 'done'"/>
                                    <field name="receiving_time"
                                           string="Waktu Validasi"
                                           readonly="1"/>
                                </group>
                                <group string="Referensi Stok">
                                    <field name="picking_id"
                                           string="Penerimaan Stok (Picking)"
                                           readonly="1"
                                           invisible="not picking_id"/>
                                </group>
                            </group>
                            <group string="Catatan Umum">
                                <field name="notes"
                                       nolabel="1"
                                       readonly="state == 'done'"/>
                            </group>
                        </page>

                        <!-- ─── Tab 4: Lampiran ─── -->
                        <page string="Lampiran" name="tab_lampiran">
                            <group>
                                <group string="Dokumen">
                                    <field name="attachment_delivery"
                                           string="Surat Jalan"
                                           filename="attachment_delivery_name"
                                           widget="binary"/>
                                    <field name="attachment_delivery_name"
                                           invisible="1"/>
                                    <field name="attachment_weighing"
                                           string="Slip Timbangan"
                                           filename="attachment_weighing_name"
                                           widget="binary"/>
                                    <field name="attachment_weighing_name"
                                           invisible="1"/>
                                    <field name="attachment_additional"
                                           string="Lampiran Tambahan"
                                           filename="attachment_additional_name"
                                           widget="binary"/>
                                    <field name="attachment_additional_name"
                                           invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- ─── Tab 5: Pergerakan Stok ─── -->
                        <page string="Pergerakan Stok" name="tab_stok"
                              invisible="not picking_id">
                            <field name="move_ids" readonly="1">
                                <list string="Pergerakan Stok">
                                    <field name="product_id" string="Produk"/>
                                    <field name="product_uom_qty" string="Qty Diminta"/>
                                    <field name="quantity" string="Qty Dilakukan"/>
                                    <field name="product_uom" string="Satuan"/>
                                    <field name="state" string="Status"
                                           widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-warning="state == 'assigned'"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════
         List View – coconut.receipt
         ═══════════════════════════════════════════════════ -->
    <record id="view_coconut_receipt_tree" model="ir.ui.view">
        <field name="name">coconut.receipt.list</field>
        <field name="model">coconut.receipt</field>
        <field name="arch" type="xml">
            <list string="Penerimaan Kelapa"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">
                <field name="name" string="Kode Penerimaan"/>
                <field name="entry_datetime" string="Tgl Masuk"/>
                <field name="partner_id" string="Pemasok"/>
                <field name="origin" string="Asal Kelapa"/>
                <field name="vehicle_plate" string="No. Polisi"/>
                <field name="gross_vehicle_weight" string="Bruto (Kg)" sum="Total Bruto"/>
                <field name="tare_vehicle_weight" string="Tara (Kg)" sum="Total Tara"/>
                <field name="net_received_weight" string="Bersih (Kg)" sum="Total Bersih"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════
         Search View – coconut.receipt
         ═══════════════════════════════════════════════════ -->
    <record id="view_coconut_receipt_search" model="ir.ui.view">
        <field name="name">coconut.receipt.search</field>
        <field name="model">coconut.receipt</field>
        <field name="arch" type="xml">
            <search string="Cari Penerimaan Kelapa">
                <field name="name" string="Kode Penerimaan"/>
                <field name="partner_id" string="Pemasok"/>
                <field name="vehicle_plate" string="Nomor Polisi"/>
                <field name="origin" string="Asal Kelapa"/>
                <separator/>
                <filter string="Draft"     name="draft"    domain="[('state','=','draft')]"/>
                <filter string="Selesai"   name="done"     domain="[('state','=','done')]"/>
                <filter string="Dibatalkan" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <group expand="0" string="Kelompokkan Berdasarkan">
                    <filter string="Pemasok"  name="grp_supplier" context="{'group_by':'partner_id'}"/>
                    <filter string="Status"   name="grp_state"    context="{'group_by':'state'}"/>
                    <filter string="Asal"     name="grp_origin"   context="{'group_by':'origin'}"/>
                    <filter string="Tanggal"  name="grp_date"     context="{'group_by':'entry_datetime:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════
         Action
         ═══════════════════════════════════════════════════ -->
    <record id="action_coconut_receipt" model="ir.actions.act_window">
        <field name="name">Penerimaan Kelapa</field>
        <field name="res_model">coconut.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_coconut_receipt_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat Penerimaan Kelapa baru
            </p>
            <p>
                Catat data timbangan, penilaian kualitas, dan lakukan validasi
                untuk menambah Kelapa Bulat ke persediaan gudang.
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════
         Menus
         ═══════════════════════════════════════════════════ -->
    <menuitem id="menu_coconut_receiving_root"
              name="Penerimaan Kelapa"
              sequence="40"/>
    <menuitem id="menu_coconut_receipt"
              name="Penerimaan"
              parent="menu_coconut_receiving_root"
              action="action_coconut_receipt"
              sequence="10"/>

</odoo>
