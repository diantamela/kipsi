<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dummy security group to hide unused elements -->
    <record id="group_unused_features" model="res.groups">
        <field name="name">Hidden Features (PT Coco Murni Prima Jaya)</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <!-- 1. Inventory Overview: Hide "Order Pengiriman" card -->
    <record id="stock_picking_type_kanban_inherit" model="ir.ui.view">
        <field name="name">stock.picking.type.kanban.inherit</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.stock_picking_type_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='stock_picking']" position="attributes">
                <attribute name="t-if">record.show_picking_type.raw_value and record.code.raw_value != 'outgoing'</attribute>
            </xpath>
        </field>
    </record>

    <!-- Archive Outgoing picking type (Order Pengiriman) -->
    <record id="stock.picking_type_out" model="stock.picking.type">
        <field name="active">False</field>
    </record>

    <!-- 2. Inventory Menus: Hide Pengiriman, Pengadaan, Replenishment, Tatanama Barcode -->
    <record id="stock.out_picking" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>
    <record id="stock.menu_stock_procurement" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>
    <record id="stock.menu_reordering_rules_replenish" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>
    <record id="stock.menu_wms_barcode_nomenclature_all" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>
    <record id="stock.menu_procurement_compute" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>
    <record id="stock.menu_delivery" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>

    <!-- Hide native Stock Overview menu -->
    <record id="stock.stock_picking_type_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>

    <!-- Hide MRP Scheduler menu (Perencanaan -> Pengadaan: jalankan penjadwal) -->
    <record id="mrp.menu_procurement_compute_mrp" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>

    <!-- 3. Purchase: PO form customizations -->
    <record id="purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Hide Create Bill buttons in header -->
            <xpath expr="//header/button[@name='action_create_invoice'][hasclass('oe_highlight')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_create_invoice'][not(hasclass('oe_highlight'))]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide smart buttons in button box -->
            <xpath expr="//button[@name='action_bill_matching']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide qty_invoiced and taxes_id on order lines list view -->
            <xpath expr="//field[@name='order_line']/list/field[@name='qty_invoiced']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='taxes_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <!-- Hide qty_invoiced, taxes_id, and invoice_lines in order lines form view -->
            <xpath expr="//field[@name='order_line']/form//field[@name='qty_invoiced']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='taxes_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='invoice_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide invoicing fields in Other Info -->
            <xpath expr="//field[@name='invoice_status']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='fiscal_position_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Purchase: PO tree views customizations (Hide Create Bill buttons & columns) -->
    <record id="purchase_order_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_kpis_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_create_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_status']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_create_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_status']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- 4. Product Customizations: Form and Tree views -->
    <record id="product_template_form_view_inherit_coco" model="ir.ui.view">
        <field name="name">product.template.form.inherit.coco</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Hide Sales Price -->
            <xpath expr="//label[@for='list_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='list_price_uom']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide Cost -->
            <xpath expr="//label[@id='standard_price_label']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide Customer Taxes -->
            <xpath expr="//label[@for='taxes_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='taxes_div']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide Vendor Taxes -->
            <xpath expr="//field[@name='supplier_taxes_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide Invoicing/Accounting Page -->
            <xpath expr="//page[@name='invoicing']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide Routes (Operations group) -->
            <xpath expr="//group[@name='operations']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide Packaging -->
            <xpath expr="//group[@name='packaging']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide Traceability -->
            <xpath expr="//group[@name='traceability']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tracking']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide Barcode on Template Form -->
    <record id="product_template_only_form_view_inherit_coco" model="ir.ui.view">
        <field name="name">product.template.only.form.inherit.coco</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide Barcode/Cost/Price on Variant Form -->
    <record id="product_normal_form_view_inherit_coco" model="ir.ui.view">
        <field name="name">product.product.form.inherit.coco</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='lst_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide Columns in Product Tree Views -->
    <record id="product_template_tree_view_inherit_coco" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.coco</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view_inherit_coco" model="ir.ui.view">
        <field name="name">product.product.tree.inherit.coco</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lst_price']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_view_tree_inherit_coco" model="ir.ui.view">
        <field name="name">product.template.view.tree.inherit.coco</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='taxes_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='supplier_taxes_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide Invoicing/Accounting Menu from main navbar -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>

    <!-- Hide Purchase Menu from main navbar -->
    <record id="purchase.menu_purchase_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>

    <!-- 5. Inventory Operations: Override default menus to point to custom models -->
    <!-- Rename "Penerimaan" to "Penerimaan Kelapa" and direct to coconut_receiving.action_coconut_receipt -->
    <record id="stock.in_picking" model="ir.ui.menu">
        <field name="name">Penerimaan Kelapa</field>
        <field name="action" ref="coconut_receiving.action_coconut_receipt"/>
    </record>

    <!-- Rename "Manufaktur" to "Transfer Kelapa ke Produksi" and direct to coconut_receiving.action_coconut_manufacturing -->
    <record id="mrp.mrp_operation_picking" model="ir.ui.menu">
        <field name="name">Transfer Kelapa ke Produksi</field>
        <field name="action" ref="coconut_receiving.action_coconut_manufacturing"/>
    </record>

    <!-- Rename Inventory root menu to "Persediaan" and set homepage to Products -->
    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field name="name">Persediaan</field>
        <field name="action" ref="stock.product_template_action_product"/>
    </record>

    <!-- Direct native Manufacturing Orders in production module to custom manufacturing view -->
    <record id="mrp.menu_mrp_production_action" model="ir.ui.menu">
        <field name="action" ref="coconut_receiving.action_coconut_manufacturing"/>
    </record>

    <!-- 6. Kelapa Module Overview Card with Bar Chart -->
    <record id="action_coconut_picking_type_kanban" model="ir.actions.act_window">
        <field name="name">Overview</field>
        <field name="res_model">stock.picking.type</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('code', '=', 'incoming')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Overview Penerimaan Kelapa
            </p>
        </field>
    </record>

    <!-- Clear Dashboard action from Manufacturing root menu (was set from old config) -->
    <record id="mrp.menu_mrp_root" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>

    <!-- Hide Overview (Dashboard) from Coconut Receiving production module -->
    <record id="menu_coconut_overview" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>

    <!-- Hide "Dashboards" sub-menu from Dashboards navbar -->
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_dashboard" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>

    <!-- Hide "Configuration" sub-menu from Dashboards navbar -->
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_configuration" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_unused_features')])]"/>
    </record>

    <!-- Hide signup link on login page -->
    <template id="auth_signup_login_hide_signup" inherit_id="auth_signup.login">
        <xpath expr="//p[a[@t-if='signup_enabled']]" position="replace"/>
    </template>
</odoo>
