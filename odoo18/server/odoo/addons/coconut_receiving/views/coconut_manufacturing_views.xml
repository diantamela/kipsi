<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════
         Form View – coconut.manufacturing (PKK)
         ═══════════════════════════════════════════════════ -->
    <record id="view_coconut_manufacturing_form" model="ir.ui.view">
        <field name="name">coconut.manufacturing.form</field>
        <field name="model">coconut.manufacturing</field>
        <field name="arch" type="xml">
            <form string="Transfer Kelapa ke Produksi">
                <header>
                    <button name="action_confirm"
                            id="btn_confirm_mfg"
                            string="Konfirmasi"
                            type="object"
                            invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_validate"
                            id="btn_validate_mfg"
                            string="Selesaikan &amp; Buat Pergerakan Stok"
                            type="object"
                            invisible="state != 'confirmed'"
                            class="oe_highlight"/>
                    <button name="action_cancel"
                            id="btn_cancel_mfg"
                            string="Batalkan"
                            type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft"
                            id="btn_reset_mfg"
                            string="Kembalikan ke Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <!-- Print PDF -->
                    <button name="%(action_report_coconut_manufacturing)d"
                            string="Print → Laporan Transfer Kelapa ke Produksi"
                            type="action"
                            class="btn-secondary"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Informasi Transfer -->
                    <group>
                        <group string="Informasi Transfer">
                            <field name="production_date"
                                   readonly="state != 'draft'"/>
                            <field name="spk_number"
                                   readonly="state != 'draft'"/>
                            <field name="responsible_id"
                                   string="Operator / Karyawan"
                                   readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Transfer Material -->
                        <page string="Transfer Material" name="tab_transfer_material">
                            <!-- Transfer Sheller -->
                            <group string="Transfer ke Sheller">
                                <group>
                                    <field name="available_kelapa_layak"
                                           string="Stok Kelapa Layak Tersedia (Kg)"
                                           readonly="1"/>
                                    <field name="sheller_mesin_qty"
                                           string="Kelapa Layak ke Sheller Mesin (Kg)"
                                           readonly="state != 'draft'"/>
                                    <field name="sheller_manual_qty"
                                           string="Kelapa Layak ke Sheller Manual (Kg)"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="total_transfer_sheller"
                                           string="Total Transfer Sheller (Kg)"
                                           readonly="1"/>
                                    <field name="remaining_kelapa_layak"
                                           string="Sisa Kelapa Layak Setelah Transfer (Kg)"
                                           readonly="1"/>
                                </group>
                            </group>

                            <!-- Transfer Perrer -->
                            <group string="Transfer ke Perrer">
                                <group string="Sumber: Hasil Sheller Mesin">
                                    <field name="available_hasil_sheller_mesin"
                                           string="Stok Hasil Sheller Mesin Tersedia (Kg)"
                                           readonly="1"/>
                                    <field name="transfer_perrer_mesin_qty"
                                           string="Hasil Sheller Mesin Ditransfer ke Perrer (Kg)"
                                           readonly="state != 'draft'"/>
                                    <field name="remaining_hasil_sheller_mesin"
                                           string="Sisa Hasil Sheller Mesin Setelah Transfer (Kg)"
                                           readonly="1"/>
                                </group>
                                <group string="Sumber: Hasil Sheller Manual">
                                    <field name="available_hasil_sheller_manual"
                                           string="Stok Hasil Sheller Manual Tersedia (Kg)"
                                           readonly="1"/>
                                    <field name="transfer_perrer_manual_qty"
                                           string="Hasil Sheller Manual Ditransfer ke Perrer (Kg)"
                                           readonly="state != 'draft'"/>
                                    <field name="remaining_hasil_sheller_manual"
                                           string="Sisa Hasil Sheller Manual Setelah Transfer (Kg)"
                                           readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 2: Pergerakan Stok -->
                        <page string="Pergerakan Stok" name="tab_stok"
                               invisible="not sheller_mesin_move_id and not sheller_manual_move_id and not perrer_mesin_move_id and not perrer_manual_move_id">
                            <group string="Pergerakan Stok">
                                <field name="sheller_mesin_move_id" string="Pergerakan Stok Sheller Mesin" readonly="1" invisible="not sheller_mesin_move_id"/>
                                <field name="sheller_manual_move_id" string="Pergerakan Stok Sheller Manual" readonly="1" invisible="not sheller_manual_move_id"/>
                                <field name="perrer_mesin_move_id" string="Pergerakan Stok Perrer Mesin" readonly="1" invisible="not perrer_mesin_move_id"/>
                                <field name="perrer_manual_move_id" string="Pergerakan Stok Perrer Manual" readonly="1" invisible="not perrer_manual_move_id"/>
                            </group>
                        </page>

                        <!-- Tab 3: Catatan -->
                        <page string="Catatan" name="tab_catatan">
                            <group>
                                <field name="notes"
                                       string="Catatan"
                                       nolabel="1"
                                       readonly="state == 'done'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════
         List View – coconut.manufacturing
         ═══════════════════════════════════════════════════ -->
    <record id="view_coconut_manufacturing_list" model="ir.ui.view">
        <field name="name">coconut.manufacturing.list</field>
        <field name="model">coconut.manufacturing</field>
        <field name="arch" type="xml">
            <list string="Transfer Kelapa ke Produksi"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'confirmed'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">
                <field name="name" string="Kode Transfer"/>
                <field name="production_date" string="Tgl Transfer"/>
                <field name="spk_number" string="Nomor SPK"/>
                <field name="responsible_id" string="Operator"/>
                <field name="total_transfer_sheller" string="Total Transfer Sheller (Kg)" sum="Total Transfer Sheller"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════
         Search View – coconut.manufacturing
         ═══════════════════════════════════════════════════ -->
    <record id="view_coconut_manufacturing_search" model="ir.ui.view">
        <field name="name">coconut.manufacturing.search</field>
        <field name="model">coconut.manufacturing</field>
        <field name="arch" type="xml">
            <search string="Cari Transfer Kelapa ke Produksi">
                <field name="name" string="Kode Transfer"/>
                <field name="responsible_id" string="Operator"/>
                <field name="production_date" string="Tanggal"/>
                <field name="spk_number" string="Nomor SPK"/>
                <separator/>
                <filter string="Draft"        name="draft"     domain="[('state','=','draft')]"/>
                <filter string="Dikonfirmasi" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Selesai"      name="done"      domain="[('state','=','done')]"/>
                <filter string="Dibatalkan"   name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Tanggal" name="production_date_filter" date="production_date"/>
                <group expand="0" string="Kelompokkan Berdasarkan">
                    <filter string="Operator"         name="grp_operator"        context="{'group_by':'responsible_id'}"/>
                    <filter string="Status"           name="grp_state"           context="{'group_by':'state'}"/>
                    <filter string="Tanggal"          name="grp_production_date" context="{'group_by':'production_date'}"/>
                    <filter string="Nomor SPK"        name="grp_spk_number"      context="{'group_by':'spk_number'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════
         Action – coconut.manufacturing
         ═══════════════════════════════════════════════════ -->
    <record id="action_coconut_manufacturing" model="ir.actions.act_window">
        <field name="name">Transfer Kelapa ke Produksi</field>
        <field name="res_model">coconut.manufacturing</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_coconut_manufacturing_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat dokumen Transfer Kelapa ke Produksi baru
            </p>
            <p>
                Dokumen ini memindahkan Kelapa Layak Produksi ke Area Sheller.
            </p>
        </field>
    </record>

    <!-- Override / Rename Root Menu from coconut_receiving to "Penerimaan" -->
    <menuitem id="coconut_receiving.menu_coconut_receiving_root"
              name="Penerimaan"
              sequence="40"/>

    <!-- Re-parent Penerimaan Kelapa under Kelapa -->
    <menuitem id="coconut_receiving.menu_coconut_receipt"
              name="Penerimaan Kelapa"
              parent="coconut_receiving.menu_coconut_receiving_root"
              sequence="10"/>

    <!-- Sortir Kelapa – menu mandiri (bukan folder) -->
    <menuitem id="menu_coconut_sorting"
              name="Sortir Kelapa"
              parent="coconut_receiving.menu_coconut_receiving_root"
              action="action_coconut_sorting"
              sequence="20"/>

    <!-- Transfer Kelapa ke Produksi – menu langsung (bukan folder) -->
    <menuitem id="menu_coconut_manufacturing_root"
              name="Transfer Kelapa ke Produksi"
              parent="coconut_receiving.menu_coconut_receiving_root"
              action="action_coconut_manufacturing"
              sequence="30"/>
</odoo>
