<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_coconut_manufacturing" model="ir.actions.report">
        <field name="name">Laporan Transfer Kelapa ke Produksi</field>
        <field name="model">coconut.manufacturing</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">coconut_receiving.report_coconut_manufacturing_template</field>
        <field name="report_file">coconut_receiving.report_coconut_manufacturing_template</field>
        <field name="binding_model_id" ref="model_coconut_manufacturing"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template -->
    <template id="report_coconut_manufacturing_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #333;">
                        <style>
                            .company-name {
                                font-size: 18px;
                                font-weight: bold;
                                color: #1e3a1e;
                                text-align: center;
                                margin-bottom: 4px;
                            }
                            .report-title {
                                font-size: 16px;
                                font-weight: bold;
                                text-transform: uppercase;
                                color: #2e5a36;
                                border-bottom: 2px solid #4a7c59;
                                border-top: 2px solid #4a7c59;
                                padding: 8px 0;
                                margin-bottom: 20px;
                                text-align: center;
                                letter-spacing: 1px;
                            }
                            .info-table {
                                width: 100%;
                                margin-bottom: 20px;
                                border-collapse: collapse;
                            }
                            .info-table td {
                                padding: 5px 8px;
                                vertical-align: top;
                            }
                            .info-label {
                                font-weight: bold;
                                width: 180px;
                                color: #555;
                             }
                            .info-colon {
                                width: 10px;
                            }
                            .section-title {
                                font-size: 13px;
                                font-weight: bold;
                                color: #fff;
                                background-color: #4a7c59;
                                padding: 6px 12px;
                                margin-top: 20px;
                                margin-bottom: 10px;
                                text-transform: uppercase;
                                border-radius: 3px;
                            }
                            .data-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 6px;
                                margin-bottom: 15px;
                            }
                            .data-table th {
                                background-color: #e8f5e9;
                                border: 1px solid #a5d6a7;
                                padding: 7px 10px;
                                text-align: left;
                                font-weight: bold;
                                color: #1e3a1e;
                            }
                            .data-table td {
                                border: 1px solid #ddd;
                                padding: 7px 10px;
                            }
                            .data-table tr:nth-child(even) td {
                                background-color: #f9f9f9;
                            }
                            .text-right { text-align: right; }
                            .text-bold { font-weight: bold; }
                            .process-block {
                                margin-left: 15px;
                                margin-bottom: 12px;
                                line-height: 1.8;
                            }
                            .process-subtitle {
                                font-weight: bold;
                                color: #2e5a36;
                                margin-bottom: 4px;
                            }
                            .process-item {
                                margin-left: 10px;
                            }
                            .signature-container {
                                margin-top: 50px;
                                width: 100%;
                                overflow: hidden;
                            }
                            .signature-box {
                                text-align: center;
                                width: 33%;
                                float: left;
                            }
                            .signature-line {
                                margin-top: 60px;
                                border-top: 1px solid #333;
                                padding-top: 4px;
                                font-weight: bold;
                            }
                            .clear-fix { clear: both; }
                            .status-badge {
                                display: inline-block;
                                padding: 2px 8px;
                                border-radius: 3px;
                                font-size: 11px;
                                font-weight: bold;
                            }
                            .badge-done { background-color: #4caf50; color: white; }
                            .badge-confirmed { background-color: #ff9800; color: white; }
                            .badge-draft { background-color: #2196f3; color: white; }
                        </style>

                        <!-- ══ HEADER ══ -->
                        <div class="company-name">PT Coco Murni Prima Jaya</div>
                        <div class="report-title">LAPORAN TRANSFER KELAPA KE PRODUKSI</div>

                        <!-- ══ INFORMASI DOKUMEN ══ -->
                        <table class="info-table">
                            <tr>
                                <td class="info-label">Kode Transfer</td>
                                <td class="info-colon">:</td>
                                <td><strong><span t-field="doc.name"/></strong></td>
                                <td class="info-label">Operator</td>
                                <td class="info-colon">:</td>
                                <td><span t-field="doc.responsible_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="info-label">Tanggal Transfer</td>
                                <td class="info-colon">:</td>
                                <td><span t-field="doc.production_date" t-options='{"widget": "date"}'/></td>
                                <td class="info-label">Nomor SPK</td>
                                <td class="info-colon">:</td>
                                <td><span t-field="doc.spk_number"/></td>
                            </tr>
                            <tr>
                                <td class="info-label">Status Realisasi</td>
                                <td class="info-colon">:</td>
                                <td>
                                    <span t-if="doc.realisasi_state == 'no_result'">Belum Ada Hasil Kerja</span>
                                    <span t-elif="doc.realisasi_state == 'partial'">Sebagian</span>
                                    <span t-elif="doc.realisasi_state == 'done'">Selesai</span>
                                </td>
                                <td class="info-label">Status Dokumen</td>
                                <td class="info-colon">:</td>
                                <td>
                                    <span t-if="doc.state == 'draft'" class="status-badge badge-draft">Draft</span>
                                    <span t-elif="doc.state == 'confirmed'" class="status-badge badge-confirmed">Dikonfirmasi</span>
                                    <span t-elif="doc.state == 'done'" class="status-badge badge-done">Selesai</span>
                                    <span t-else="">Dibatalkan</span>
                                </td>
                            </tr>
                        </table>

                        <t t-set="stock_data" t-value="doc.get_report_stock_data()"/>

                        <!-- ══ SECTION 1: PERSEDIAAN AWAL ══ -->
                        <div class="section-title">1. Persediaan Awal Bahan Baku</div>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Produk</th>
                                    <th>Lokasi Asal</th>
                                    <th class="text-right">Stok Awal (Kg)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Kelapa Layak Produksi</td>
                                    <td>Stok Kelapa Layak</td>
                                    <td class="text-right"><t t-esc="doc.format_kg(stock_data['layak']['awal'])"/></td>
                                </tr>
                                <tr>
                                    <td>Kelapa Sheller (Hasil Mesin)</td>
                                    <td>Stok Hasil Sheller Mesin</td>
                                    <td class="text-right"><t t-esc="doc.format_kg(stock_data['hasil_mesin']['awal'])"/></td>
                                </tr>
                                <tr>
                                    <td>Kelapa Sheller (Hasil Manual)</td>
                                    <td>Stok Hasil Sheller Manual</td>
                                    <td class="text-right"><t t-esc="doc.format_kg(stock_data['hasil_manual']['awal'])"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ══ SECTION 2: TRANSFER KE SHELLER ══ -->
                        <div class="section-title">2. Transfer ke Sheller</div>
                        <div class="process-block">
                            <div class="process-item">
                                <span>Kelapa Layak ke Sheller Mesin: </span>
                                <strong><t t-esc="doc.format_kg(doc.sheller_mesin_qty)"/></strong>
                            </div>
                            <div class="process-item">
                                <span>Kelapa Layak ke Sheller Manual: </span>
                                <strong><t t-esc="doc.format_kg(doc.sheller_manual_qty)"/></strong>
                            </div>
                            <div class="process-item">
                                <span>Total Transfer ke Sheller: </span>
                                <strong><t t-esc="doc.format_kg(doc.total_transfer_sheller)"/></strong>
                            </div>
                        </div>

                        <!-- ══ SECTION 3: TRANSFER KE PERRER ══ -->
                        <div class="section-title">3. Transfer ke Perrer (Area Parer)</div>
                        <div class="process-block">
                            <div class="process-item">
                                <span>Hasil Sheller Mesin Ditransfer ke Perrer: </span>
                                <strong><t t-esc="doc.format_kg(doc.transfer_perrer_mesin_qty)"/></strong>
                            </div>
                            <div class="process-item">
                                <span>Hasil Sheller Manual Ditransfer ke Perrer: </span>
                                <strong><t t-esc="doc.format_kg(doc.transfer_perrer_manual_qty)"/></strong>
                            </div>
                        </div>

                        <!-- ══ SECTION 4: REALISASI HASIL KERJA ══ -->
                        <div class="section-title">4. Realisasi Hasil Kerja</div>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Proses Kerja</th>
                                    <th class="text-right">Jumlah Ditransfer (Kg)</th>
                                    <th class="text-right">Realisasi Hasil Kerja (Kg)</th>
                                    <th class="text-right">Sisa Area (Kg)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Sheller Mesin</td>
                                    <td class="text-right"><t t-esc="doc.format_kg_raw(doc.sheller_mesin_qty)"/></td>
                                    <td class="text-right"><t t-esc="doc.format_kg_raw(doc.realisasi_sheller_mesin)"/></td>
                                    <td class="text-right text-bold"><t t-esc="doc.format_kg_raw(doc.sheller_mesin_qty - doc.realisasi_sheller_mesin)"/></td>
                                </tr>
                                <tr>
                                    <td>Sheller Manual</td>
                                    <td class="text-right"><t t-esc="doc.format_kg_raw(doc.sheller_manual_qty)"/></td>
                                    <td class="text-right"><t t-esc="doc.format_kg_raw(doc.realisasi_sheller_manual)"/></td>
                                    <td class="text-right text-bold"><t t-esc="doc.format_kg_raw(doc.sheller_manual_qty - doc.realisasi_sheller_manual)"/></td>
                                </tr>
                                <tr>
                                    <td>Perrer dari Sheller Mesin</td>
                                    <td class="text-right"><t t-esc="doc.format_kg_raw(doc.transfer_perrer_mesin_qty)"/></td>
                                    <td class="text-right"><t t-esc="doc.format_kg_raw(doc.realisasi_perrer_mesin)"/></td>
                                    <td class="text-right text-bold"><t t-esc="doc.format_kg_raw(doc.transfer_perrer_mesin_qty - doc.realisasi_perrer_mesin)"/></td>
                                </tr>
                                <tr>
                                    <td>Perrer dari Sheller Manual</td>
                                    <td class="text-right"><t t-esc="doc.format_kg_raw(doc.transfer_perrer_manual_qty)"/></td>
                                    <td class="text-right"><t t-esc="doc.format_kg_raw(doc.realisasi_perrer_manual)"/></td>
                                    <td class="text-right text-bold"><t t-esc="doc.format_kg_raw(doc.transfer_perrer_manual_qty - doc.realisasi_perrer_manual)"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ══ TANDA TANGAN ══ -->
                        <div class="signature-container" style="margin-top: 60px;">
                            <div class="signature-box">
                                <div>Dibuat Oleh:</div>
                                <div class="signature-line"><span t-field="doc.responsible_id.name"/></div>
                            </div>
                            <div class="signature-box">
                                <div>Diperiksa Oleh:</div>
                                <div class="signature-line">(________________)</div>
                            </div>
                            <div class="signature-box">
                                <div>Disetujui Oleh:</div>
                                <div class="signature-line">(________________)</div>
                            </div>
                            <div class="clear-fix"></div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
