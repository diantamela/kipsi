<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View – coconut.hasil.kerja.harian -->
    <record id="view_coconut_hasil_kerja_harian_form" model="ir.ui.view">
        <field name="name">coconut.hasil.kerja.harian.form</field>
        <field name="model">coconut.hasil.kerja.harian</field>
        <field name="arch" type="xml">
            <form string="Hasil Kerja Harian">
                <header>
                    <button name="action_confirm"
                            id="btn_confirm_hkh"
                            string="Konfirmasi &amp; Validasi"
                            type="object"
                            invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_cancel"
                            id="btn_cancel_hkh"
                            string="Batalkan"
                            type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_reset_draft"
                            id="btn_reset_hkh"
                            string="Kembalikan ke Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi Transaksi">
                            <field name="transfer_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="shift" readonly="state != 'draft'"/>
                        </group>
                        <group string="Operator &amp; Mesin">
                            <field name="operator_id" string="Operator / Karyawan" readonly="state != 'draft'"/>
                            <field name="machine_id" string="Mesin" readonly="state != 'draft'"/>
                            <field name="process_type" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Kuantitas Produksi">
                            <field name="material_in_qty" string="Material Masuk (Kg)" readonly="1"/>
                            <field name="qty_hasil" string="Kuantitas Hasil (Kg)" readonly="state != 'draft'"/>
                            <field name="remaining_material" string="Sisa Material (Kg)" readonly="1"/>
                        </group>
                        <group string="Pergerakan Stok Terkait" invisible="state == 'draft'">
                            <field name="raw_move_id" readonly="1"/>
                            <field name="finished_move_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View – coconut.hasil.kerja.harian -->
    <record id="view_coconut_hasil_kerja_harian_list" model="ir.ui.view">
        <field name="name">coconut.hasil.kerja.harian.list</field>
        <field name="model">coconut.hasil.kerja.harian</field>
        <field name="arch" type="xml">
            <list string="Hasil Kerja Harian"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="shift"/>
                <field name="operator_id" string="Operator"/>
                <field name="process_type"/>
                <field name="qty_hasil" string="Hasil (Kg)" sum="Total Hasil"/>
                <field name="remaining_material" string="Sisa (Kg)" sum="Total Sisa"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- Search View – coconut.hasil.kerja.harian -->
    <record id="view_coconut_hasil_kerja_harian_search" model="ir.ui.view">
        <field name="name">coconut.hasil.kerja.harian.search</field>
        <field name="model">coconut.hasil.kerja.harian</field>
        <field name="arch" type="xml">
            <search string="Cari Hasil Kerja">
                <field name="name"/>
                <field name="operator_id" string="Operator"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Dikonfirmasi" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Dibatalkan" name="cancelled" domain="[('state','=','cancelled')]"/>
            </search>
        </field>
    </record>

    <!-- Action – coconut.hasil.kerja.harian -->
    <record id="action_coconut_hasil_kerja_harian" model="ir.actions.act_window">
        <field name="name">Hasil Kerja Harian</field>
        <field name="res_model">coconut.hasil.kerja.harian</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_coconut_hasil_kerja_harian_search"/>
    </record>

    <!-- Menu Item under mrp.menu_mrp_manufacturing -->
    <menuitem id="menu_coconut_hasil_kerja_harian"
              name="Hasil Kerja Harian"
              parent="mrp.menu_mrp_manufacturing"
              action="action_coconut_hasil_kerja_harian"
              sequence="10"/>
</odoo>
