<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Coconut Receipt -->
        <record id="seq_coconut_receipt" model="ir.sequence">
            <field name="name">Penerimaan Kelapa</field>
            <field name="code">coconut.receipt.seq</field>
            <field name="prefix">CR/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Coconut Sorting (standalone) -->
        <record id="seq_coconut_sorting" model="ir.sequence">
            <field name="name">Sequence Sortir Kelapa</field>
            <field name="code">coconut.sorting</field>
            <field name="prefix">SORT/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Coconut Manufacturing (new) -->
        <record id="seq_coconut_manufacturing" model="ir.sequence">
            <field name="name">Sequence Pemakaian Kelapa Produksi</field>
            <field name="code">coconut.manufacturing</field>
            <field name="prefix">PKK/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
