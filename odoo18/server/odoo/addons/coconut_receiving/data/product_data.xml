<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="product_coconut_with_shell" model="product.template">
            <field name="name">Kelapa Bulat</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="uom_id" ref="uom.product_uom_kgm"/>
            <field name="uom_po_id" ref="uom.product_uom_kgm"/>
            <field name="tracking">none</field>
            <field name="purchase_ok" eval="True"/>
            <field name="sale_ok" eval="False"/>
            <field name="description">Bahan baku kelapa bulat yang dibeli dari pemasok.</field>
        </record>

        <record id="product_white_meat_with_brown_skin" model="product.template">
            <field name="name">Daging Putih dengan Kulit Ari</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="uom_id" ref="uom.product_uom_kgm"/>
            <field name="uom_po_id" ref="uom.product_uom_kgm"/>
            <field name="tracking">none</field>
            <field name="purchase_ok" eval="False"/>
            <field name="sale_ok" eval="False"/>
            <field name="description">Produk setengah jadi dari proses pencungkilan kelapa.</field>
        </record>

        <record id="product_white_meat" model="product.template">
            <field name="name">Daging Putih</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="uom_id" ref="uom.product_uom_kgm"/>
            <field name="uom_po_id" ref="uom.product_uom_kgm"/>
            <field name="tracking">none</field>
            <field name="purchase_ok" eval="False"/>
            <field name="sale_ok" eval="True"/>
            <field name="description">Produk jadi setelah proses pengupasan kulit ari.</field>
        </record>

        <record id="product_brown_skin" model="product.template">
            <field name="name">Kulit Ari</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="uom_id" ref="uom.product_uom_kgm"/>
            <field name="uom_po_id" ref="uom.product_uom_kgm"/>
            <field name="tracking">none</field>
            <field name="purchase_ok" eval="False"/>
            <field name="sale_ok" eval="False"/>
            <field name="description">Produk sampingan dari proses pengupasan kulit ari daging putih.</field>
        </record>

    </data>
</odoo>
