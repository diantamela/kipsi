<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Call this template instead of "web.assets_tests" to have the proper conditional check -->
    <template id="conditional_assets_tests" name="Tests Assets Bundle">
        <t t-if="'tests' in debug or test_mode_enabled">
            <t t-if="ignore_missing_deps">
                <!-- FIXME: This is only to ignore the errors for the lazy loading. To allow all tests assets and tours to be in the same bundle, the assets_tests bundle ignores missing dependencies -->
                <t t-call-assets="web.__assets_tests_call__" defer_load="True" />
            </t>
            <t t-else="">
                <t t-call-assets="web.assets_tests" defer_load="True" />
            </t>
        </t>
    </template>

    <template id="web.layout" name="Web layout">&lt;!DOCTYPE html&gt;
<html t-att="html_data or {}">
    <head>
        <meta charset="utf-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
        <title t-esc="title or 'Odoo'"/>
        <link type="image/x-icon" rel="shortcut icon" t-att-href="x_icon or '/web/static/img/favicon.ico'"/>
        <script id="web.layout.odooscript" type="text/javascript">
            var odoo = {
                csrf_token: "<t t-nocache="The csrf token must always be up to date." t-esc="request.csrf_token(None)"/>",
                debug: "<t t-esc="debug"/>",
            };
        </script>
        <t t-out="head or ''"/>
    </head>
    <body t-att-class="body_classname">
        <t t-out="0"/>
    </body>
</html>
    </template>

    <template id="web.frontend_layout" name="Frontend Layout" inherit_id="web.layout" primary="True">
      <xpath expr="//head/meta[last()]" position="after">
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
      </xpath>
      <xpath expr="//head/link[last()]" position="after">
        <link rel="preload" href="/web/static/src/libs/fontawesome/fonts/fontawesome-webfont.woff2?v=4.7.0" as="font" crossorigin=""/>
        <t t-call-assets="web.assets_frontend" t-js="false"/>
      </xpath>
      <xpath expr="//head/script[@id='web.layout.odooscript']" position="after">
        <script t-nocache="Session information should always be up to date." type="text/javascript">
            odoo.__session_info__ = <t t-out="json.dumps(request.env['ir.http'].get_frontend_session_info())"/>;
            if (!/(^|;\s)tz=/.test(document.cookie)) {
                const userTZ = Intl.DateTimeFormat().resolvedOptions().timeZone;
                document.cookie = `tz=${userTZ}; path=/`;
            }
        </script>
        <t t-call-assets="web.assets_frontend_minimal" t-css="false" defer_load="True"/>
        <t t-call="web.conditional_assets_tests">
            <t t-set="ignore_missing_deps" t-value="True"/>
        </t>
        <t t-call-assets="web.assets_frontend_lazy" t-css="false" lazy_load="True"/>
      </xpath>
        <xpath expr="//t[@t-out='0']" position="replace">
            <div id="wrapwrap" t-attf-class="#{pageName or ''}">
                <header t-if="not no_header" id="top" data-anchor="true">
                    <img class="img-responsive d-block mx-auto"
                        t-attf-src="/web/binary/company_logo"
                        alt="Logo"/>
                </header>
                <main>
                    <t t-out="0"/>
                </main>
                <footer t-cache="no_footer,no_copyright" t-if="not no_footer" id="bottom" data-anchor="true" t-attf-class="bg-light o_footer">
                    <div id="footer"/>
                    <div t-if="not no_copyright" class="o_footer_copyright">
                        <div class="container py-3">
                            <div class="row">
                                <div class="col-sm text-center text-sm-start text-muted">
                                    <span class="o_footer_copyright_name me-2">Copyright &amp;copy; <span t-field="res_company.name" itemprop="name">Company name</span></span>
                                </div>
                                <div class="col-sm text-center text-sm-end">
                                    <t t-call="web.brand_promotion"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </footer>
            </div>
        </xpath>
    </template>

    <template id="brand_promotion_message" name="Brand Promotion Message">
        <t t-set="odoo_logo">
            <a target="_blank"
                t-attf-href="http://www.odoo.com?utm_source=db&amp;utm_medium=#{_utm_medium}"
                class="badge text-bg-light">
                <img alt="Odoo"
                    src="/web/static/img/odoo_logo_tiny.png"
                    width="62" height="20"
                    style="width: auto; height: 1em; vertical-align: baseline;"/>
            </a>
        </t>
        <t t-set="final_message">Powered by %s%s</t>
        <t t-out="final_message % (odoo_logo, _message and ('- ' + _message) or '')"/>
    </template>
    <template id="brand_promotion" name="Brand Promotion">
        <div class="o_brand_promotion">
            <t t-call="web.brand_promotion_message">
                <t t-set="_message"></t>
                <t t-set="_utm_medium" t-valuef="portal"/>
            </t>
        </div>
    </template>

    <template id="web.login_layout" name="Login Layout">
        <t t-call="web.frontend_layout">
            <t t-set="head">
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;display=swap"/>
                <style>
                    body {
                        background-color: #fcfdfe !important;
                        background-image: 
                            radial-gradient(circle at 10% 20%, rgba(181, 228, 188, 0.18) 0%, transparent 45%),
                            radial-gradient(circle at 90% 80%, rgba(181, 228, 188, 0.18) 0%, transparent 45%),
                            radial-gradient(rgba(46, 89, 56, 0.05) 1.5px, transparent 1.5px) !important;
                        background-size: 100% 100%, 100% 100%, 24px 24px !important;
                        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
                        min-height: 100vh;
                        margin: 0;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    }
                    #wrapwrap {
                        display: flex;
                        flex-direction: column;
                        justify-content: center;
                        align-items: center;
                        width: 100%;
                        min-height: 100vh;
                        background: transparent !important;
                    }
                    main {
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        width: 100%;
                        flex-grow: 1;
                    }
                    
                    /* Custom 3-column layout container */
                    .login-container-fluid {
                        width: 100%;
                        max-width: 1440px;
                        margin: 0 auto;
                        padding: 1.5rem;
                        display: grid;
                        grid-template-columns: 1fr;
                        align-items: center;
                        gap: 2rem;
                    }
                    
                    @media (min-width: 1200px) {
                        .login-container-fluid {
                            grid-template-columns: 320px 1fr 320px;
                            gap: 4rem;
                            padding: 2rem 4rem;
                        }
                    }

                    /* Left Pane */
                    .login-left-pane {
                        height: 100%;
                        display: flex;
                        flex-direction: column;
                        justify-content: center;
                        position: relative;
                        padding-bottom: 80px;
                    }
                    
                    .login-left-pane .headline-title {
                        font-size: 2.8rem;
                        font-weight: 800;
                        color: #0c4d22;
                        line-height: 1.25;
                        margin-bottom: 1.25rem;
                        margin-top: 2rem;
                    }
                    
                    .login-left-pane .headline-desc {
                        font-size: 0.95rem;
                        color: #556b5c;
                        line-height: 1.6;
                        max-width: 290px;
                        margin: 0;
                    }
                    
                    .login-left-pane .coconut-deco {
                        position: absolute;
                        bottom: -100px;
                        left: -60px;
                        width: 320px;
                        z-index: 1;
                        pointer-events: none;
                        filter: drop-shadow(0 20px 30px rgba(46, 89, 56, 0.12));
                    }

                    /* Center Pane (Card Form) */
                    .o_database_list {
                        background: rgba(255, 255, 255, 0.92) !important;
                        backdrop-filter: blur(20px) saturate(140%) !important;
                        -webkit-backdrop-filter: blur(20px) saturate(140%) !important;
                        border: 1px solid rgba(255, 255, 255, 0.7) !important;
                        border-radius: 2rem !important;
                        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.03), 0 2px 8px rgba(0, 0, 0, 0.01) !important;
                        transition: transform 0.3s ease, box-shadow 0.3s ease;
                        width: 100%;
                    }
                    
                    .o_database_list:hover {
                        box-shadow: 0 40px 80px rgba(0, 0, 0, 0.05), 0 2px 8px rgba(0, 0, 0, 0.01) !important;
                    }
                    
                    .form-label {
                        font-size: 0.85rem !important;
                        font-weight: 700 !important;
                        color: #2e5938 !important;
                        margin-bottom: 0.4rem !important;
                    }
                    
                    .form-control {
                        font-family: 'Plus Jakarta Sans', sans-serif !important;
                        font-size: 0.9rem !important;
                        padding: 0.7rem 1.1rem !important;
                        border: 1px solid rgba(46, 89, 56, 0.12) !important;
                        border-radius: 0.75rem !important;
                        background-color: #ffffff !important;
                        color: #1e3a24 !important;
                        box-shadow: none !important;
                        transition: all 0.2s ease-in-out !important;
                    }
                    
                    .form-control:focus {
                        background-color: #ffffff !important;
                        border-color: #418252 !important;
                        box-shadow: 0 0 0 4px rgba(65, 130, 82, 0.12) !important;
                        outline: none !important;
                    }

                    /* Input Wrapper Icons */
                    .input-icon-wrapper {
                        position: relative;
                        display: flex;
                        align-items: center;
                        width: 100%;
                    }
                    
                    .input-icon-wrapper .form-control {
                        padding-left: 2.75rem !important;
                    }
                    
                    .input-icon-wrapper .field-icon-left {
                        position: absolute;
                        left: 1rem;
                        color: #418252;
                        font-size: 1.1rem;
                        z-index: 5;
                        pointer-events: none;
                    }
                    
                    .input-icon-wrapper .field-icon-right {
                        position: absolute;
                        right: 1rem;
                        color: #88998d;
                        font-size: 1.1rem;
                        z-index: 5;
                        cursor: pointer;
                    }

                    /* Buttons */
                    .btn-masuk-primary {
                        font-family: 'Plus Jakarta Sans', sans-serif !important;
                        font-weight: 700 !important;
                        font-size: 0.95rem !important;
                        background: linear-gradient(135deg, #469c61 0%, #2e7a46 100%) !important;
                        border: none !important;
                        color: #ffffff !important;
                        padding: 0.8rem 1.2rem !important;
                        border-radius: 0.75rem !important;
                        box-shadow: 0 4px 14px rgba(46, 122, 70, 0.25) !important;
                        transition: all 0.25s ease !important;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        position: relative;
                        width: 100%;
                    }
                    
                    .btn-masuk-primary:hover {
                        background: linear-gradient(135deg, #51ac6d 0%, #348a4f 100%) !important;
                        box-shadow: 0 6px 20px rgba(46, 122, 70, 0.35) !important;
                        transform: translateY(-1px) !important;
                    }
                    
                    .btn-masuk-primary:active {
                        transform: translateY(0) !important;
                    }

                    .btn-outline-superuser {
                        font-family: 'Plus Jakarta Sans', sans-serif !important;
                        font-weight: 600 !important;
                        font-size: 0.9rem !important;
                        color: #2e7a46 !important;
                        background: #ffffff !important;
                        border: 1px solid #2e7a46 !important;
                        padding: 0.75rem 1.2rem !important;
                        border-radius: 0.75rem !important;
                        transition: all 0.2s ease !important;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        width: 100%;
                        text-decoration: none !important;
                    }
                    
                    .btn-outline-superuser:hover {
                        background: #f4fbf6 !important;
                        color: #205c32 !important;
                        border-color: #205c32 !important;
                    }
                    
                    .form-label a, a.text-success-custom, .oe_login_form + div a, .oe_login_form ~ div a {
                        color: #2e7a46 !important;
                        font-weight: 600 !important;
                        text-decoration: none !important;
                        font-size: 0.75rem !important;
                        transition: color 0.2s ease !important;
                    }
                    
                    .form-label a:hover, a.text-success-custom:hover, .oe_login_form + div a:hover, .oe_login_form ~ div a:hover {
                        color: #1e5930 !important;
                        text-decoration: underline !important;
                    }

                    /* Right Pane Mock Widgets */
                    .login-right-pane {
                        display: flex;
                        flex-direction: column;
                        gap: 1.5rem;
                    }
                    
                    .mock-widget-card {
                        background: #ffffff;
                        border-radius: 1.25rem;
                        border: 1px solid rgba(46, 89, 56, 0.06);
                        padding: 1.25rem;
                        box-shadow: 0 10px 30px rgba(46, 89, 56, 0.02);
                        transition: transform 0.3s ease;
                    }
                    
                    .mock-widget-card:hover {
                        transform: translateY(-2px);
                    }
                </style>
            </t>
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
            <t t-set="body_classname" t-value="''"/>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>

            <div class="login-container-fluid">
                <!-- Left Pane -->
                <div class="login-left-pane d-none d-xl-flex">
                    <div class="top-logo-section">
                        <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}" alt="Logo" style="max-height: 70px; width: auto; max-width: 250px;"/>
                    </div>
                    <div class="middle-text-section">
                        <h1 class="headline-title">Masuk ke<br/>Sistem ERP</h1>
                        <p class="headline-desc">Kelola operasional PT Coco Murni Prima Jaya dengan aman dan efisien.</p>
                    </div>
                    <!-- <img src="/coconut_payroll/static/src/img/coconut_illustration.png" class="coconut-deco" alt="Coconut"/> -->
                </div>

                <!-- Center Pane -->
                <div class="login-center-pane d-flex align-items-center justify-content-center">
                    <div t-attf-class="card border-0 mx-auto {{login_card_classes}} o_database_list" style="max-width: 340px;">
                        <div class="card-body p-4">
                            <t t-out="0"/>
                            
                            <div class="text-center small mt-4 pt-3" style="border-top: 1px solid rgba(46, 89, 56, 0.08);" t-if="not disable_footer">
                                <div class="d-flex align-items-center justify-content-between" style="font-size: 0.8rem;">
                                    <t t-if="not disable_database_manager">
                                        <a href="/web/database/manager" style="color: #2e5938 !important; font-weight: 600; text-decoration: none;"><i class="fa fa-database me-1"></i> Mengelola Database</a>
                                    </t>
                                    <span style="color: rgba(46, 89, 56, 0.15);">|</span>
                                    <a href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth" target="_blank" style="color: #88998d !important; text-decoration: none;">Disajikan oleh <span style="font-weight: bold; color: #2e5938;">odoo</span></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Pane -->
                <div class="login-right-pane d-none d-xl-flex">
                    <!-- Widget 1: Kinerja Produksi -->
                    <div class="mock-widget-card">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span style="font-size: 0.8rem; font-weight: 700; color: #2e5938;">Kinerja Produksi</span>
                            <span style="background: #eefaf0; color: #1e873b; font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.45rem; border-radius: 2rem;">+12.5%</span>
                        </div>
                        <svg viewBox="0 0 100 30" width="100%" height="45" style="overflow: visible;">
                            <defs>
                                <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#418252" stop-opacity="0.25"/>
                                    <stop offset="100%" stop-color="#418252" stop-opacity="0.0"/>
                                </linearGradient>
                            </defs>
                            <path d="M 0 25 C 20 20, 30 22, 50 12 C 70 2, 80 5, 100 2 L 100 30 L 0 30 Z" fill="url(#chartGrad)"/>
                            <path d="M 0 25 C 20 20, 30 22, 50 12 C 70 2, 80 5, 100 2" fill="none" stroke="#418252" stroke-width="2" stroke-linecap="round"/>
                            <circle cx="50" cy="12" r="2.5" fill="#ffffff" stroke="#418252" stroke-width="2"/>
                            <circle cx="100" cy="2" r="2.5" fill="#ffffff" stroke="#418252" stroke-width="2"/>
                        </svg>
                    </div>

                    <!-- Widget 2: Stok Bahan Baku & Quick Stats -->
                    <div class="mock-widget-card" style="display: flex; align-items: center; gap: 1rem;">
                        <div style="width: 50px; height: 50px; border-radius: 50%; background: conic-gradient(#418252 0% 75%, #f1f3f2 75% 100%); display: flex; align-items: center; justify-content: center; position: relative; box-shadow: inset 0 0 0 6px #ffffff;">
                            <span style="font-size: 0.8rem; font-weight: 800; color: #2e5938; position: absolute; z-index: 2;">75%</span>
                        </div>
                        <div>
                            <div style="font-size: 0.7rem; font-weight: 500; color: #88998d;">Stok Bahan Baku</div>
                            <div style="font-size: 0.85rem; font-weight: 700; color: #2e5938;">75% Tersedia</div>
                        </div>
                    </div>
                    
                    <!-- Widget 3: Quick Progress Stats -->
                    <div class="mock-widget-card" style="display: flex; flex-direction: column; gap: 0.75rem;">
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <div style="width: 28px; height: 28px; border-radius: 0.4rem; background: #eefaf0; color: #418252; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;"><i class="fa fa-user-o"></i></div>
                            <div style="height: 5px; width: 70%; background: #f1f3f2; border-radius: 10px; overflow: hidden;"><div style="width: 85%; height: 100%; background: #418252;"></div></div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <div style="width: 28px; height: 28px; border-radius: 0.4rem; background: #eefaf0; color: #418252; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;"><i class="fa fa-cube"></i></div>
                            <div style="height: 5px; width: 70%; background: #f1f3f2; border-radius: 10px; overflow: hidden;"><div style="width: 50%; height: 100%; background: #418252;"></div></div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <div style="width: 28px; height: 28px; border-radius: 0.4rem; background: #eefaf0; color: #418252; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;"><i class="fa fa-truck"></i></div>
                            <div style="height: 5px; width: 70%; background: #f1f3f2; border-radius: 10px; overflow: hidden;"><div style="width: 65%; height: 100%; background: #418252;"></div></div>
                        </div>
                    </div>

                    <!-- Widget 4: Bar Chart -->
                    <div class="mock-widget-card">
                        <div style="display: flex; align-items: flex-end; justify-content: space-between; height: 70px; padding: 0 0.25rem;">
                            <div style="width: 12%; height: 40%; background: #cce2d1; border-radius: 3px;"></div>
                            <div style="width: 12%; height: 65%; background: #a2cb8b; border-radius: 3px;"></div>
                            <div style="width: 12%; height: 95%; background: #418252; border-radius: 3px;"></div>
                            <div style="width: 12%; height: 50%; background: #a2cb8b; border-radius: 3px;"></div>
                            <div style="width: 12%; height: 80%; background: #418252; border-radius: 3px;"></div>
                            <div style="width: 12%; height: 60%; background: #cce2d1; border-radius: 3px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="web.login" name="Login">
        <t t-call="web.login_layout">
            <owl-component t-if="not login" name="web.user_switch" />
            <form t-attf-class="oe_login_form #{'' if login else 'd-none'}" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="mb-3" t-if="databases and len(databases) &gt; 1">
                    <label for="db" class="form-label d-flex justify-content-between">Database</label>
                    <div class="input-icon-wrapper">
                        <span class="field-icon-left"><i class="fa fa-database"></i></span>
                        <input type="text" name="db" t-att-value="request.db" id="db" class="form-control" required="required" readonly="readonly"/>
                        <a role="button" href="/web/database/selector" class="field-icon-right" style="text-decoration: none;"><i class="fa fa-chevron-down"></i></a>
                    </div>
                </div>

                <div class="mb-3 field-login">
                    <label for="login" class="form-label d-flex justify-content-between">Email</label>
                    <div class="input-icon-wrapper">
                        <span class="field-icon-left"><i class="fa fa-envelope-o"></i></span>
                        <input type="text" placeholder="Masukkan email" name="login" t-att-value="login" id="login" class="form-control" required="required" autocapitalize="off" autocomplete="username"/>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label d-flex justify-content-between">Kata Sandi</label>
                    <div class="input-icon-wrapper">
                        <span class="field-icon-left"><i class="fa fa-lock"></i></span>
                        <input type="password" placeholder="Masukkan kata sandi" name="password" id="password" class="form-control" required="required" autocomplete="current-password" t-att-autofocus="'autofocus' if login else None" maxlength="4096"/>
                        <span role="button" id="toggle-password" class="field-icon-right"><i class="fa fa-eye"></i></span>
                    </div>
                </div>

                <p class="alert alert-danger" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <p class="alert alert-success" t-if="message" role="status">
                    <t t-esc="message"/>
                </p>

                <div class="oe_login_buttons text-center gap-2 d-grid mb-1 pt-2">
                    <button type="submit" class="btn btn-primary btn-masuk-primary">
                        <i class="fa fa-lock me-2" style="font-size: 1rem;"></i> Masuk
                        <i class="fa fa-arrow-right position-absolute end-0 me-3"></i>
                    </button>
                    
                    <div class="my-3 d-flex align-items-center text-muted" style="font-size: 0.8rem;">
                        <div class="flex-grow-1" style="height: 1px; background-color: rgba(46, 89, 56, 0.1);"></div>
                        <span class="px-3" style="font-weight: 500;">atau</span>
                        <div class="flex-grow-1" style="height: 1px; background-color: rgba(46, 89, 56, 0.1);"></div>
                    </div>
                    
                    <t t-if="debug">
                        <button type="submit" name="redirect" value="/web/become" class="btn btn-outline-superuser">
                            <i class="fa fa-user-circle-o me-2" style="font-size: 1.05rem;"></i> Masuk sebagai superuser
                        </button>
                    </t>
                    <div class="o_login_auth"/>
                </div>

                <input type="hidden" name="type" value="password"/>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
            </form>
            
            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function() {
                    var toggleBtn = document.getElementById('toggle-password');
                    if (toggleBtn) {
                        toggleBtn.addEventListener('click', function() {
                            var pwdInput = document.getElementById('password');
                            var eyeIcon = this.querySelector('i');
                            if (pwdInput &amp;&amp; eyeIcon) {
                                if (pwdInput.type === 'password') {
                                    pwdInput.type = 'text';
                                    eyeIcon.classList.remove('fa-eye');
                                    eyeIcon.classList.add('fa-eye-slash');
                                } else {
                                    pwdInput.type = 'password';
                                    eyeIcon.classList.remove('fa-eye-slash');
                                    eyeIcon.classList.add('fa-eye');
                                }
                            }
                        });
                    }
                });
            </script>
        </t>
    </template>

