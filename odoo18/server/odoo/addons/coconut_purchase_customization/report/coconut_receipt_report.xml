<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Paper format for receipt slip -->
        <record id="paperformat_coconut_receipt_slip" model="report.paperformat">
            <field name="name">Coconut Receipt Slip</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">15</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">10</field>
            <field name="dpi">80</field>
        </record>

        <!-- Report template -->
        <record id="report_coconut_receipt" model="ir.actions.report">
            <field name="name">Coconut Receipt Slip</field>
            <field name="model">coconut.supplier.receipt</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">coconut_purchase_customization.report_coconut_receipt_template</field>
            <field name="paperformat_id" ref="paperformat_coconut_receipt_slip"/>
            <field name="binding_model_id" ref="model_coconut_supplier_receipt"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Template -->
        <template id="report_coconut_receipt_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="coconut_purchase_customization.report_coconut_receipt_content"/>
                </t>
            </t>
        </template>

        <template id="report_coconut_receipt_content">
            <div class="page">
                <div class="text-center mb-4">
                    <h2>PT COCO MURNI PRIMA JAYA</h2>
                    <h3>COCONUT RECEIPT SLIP</h3>
                    <h4>
                        <span t-esc="doc.name"/>
                    </h4>
                </div>

                <table class="table table-bordered">
                    <tr>
                        <td width="30%"><strong>CV Supplier</strong></td>
                        <td width="70%" t-esc="doc.supplier_id.name or ''"/>
                    </tr>
                    <tr>
                        <td><strong>Contact Person</strong></td>
                        <td t-esc="doc.contact_person or ''"/>
                    </tr>
                    <tr>
                        <td><strong>Supplier Phone</strong></td>
                        <td t-esc="doc.supplier_phone or ''"/>
                    </tr>
                    <tr>
                        <td><strong>Supplier Address</strong></td>
                        <td t-esc="doc.supplier_address or ''"/>
                    </tr>
                </table>

                <h4 class="mt-3">Delivery Data</h4>
                <table class="table table-bordered">
                    <tr>
                        <td width="30%"><strong>Driver Name</strong></td>
                        <td width="70%" t-esc="doc.driver_name"/>
                    </tr>
                    <tr>
                        <td><strong>Driver Phone</strong></td>
                        <td t-esc="doc.driver_phone"/>
                    </tr>
                    <tr>
                        <td><strong>Vehicle Number</strong></td>
                        <td t-esc="doc.vehicle_number"/>
                    </tr>
                    <tr>
                        <td><strong>Receipt Date</strong></td>
                        <td>
                            <span t-esc="doc.date_received"/>
                            &nbsp; &nbsp;
                            <span t-esc="doc.time_in"/>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>RMP Employee</strong></td>
                        <td t-esc="doc.rmp_employee_id.name or ''"/>
                    </tr>
                </table>

                <h4 class="mt-3">Quality Data</h4>
                <table class="table table-bordered">
                    <tr class="bg-light">
                        <td width="30%"><strong>Total Weight</strong></td>
                        <td width="20%">
                            <span t-esc="doc.total_weight_kg"/> Kg
                        </td>
                        <td width="15%"><strong>Machine Cracked</strong></td>
                        <td width="20%">
                            <span t-esc="doc.machine_cracked_kg"/> Kg
                        </td>
                        <td width="15%"><strong>Manual Cracked</strong></td>
                        <td>
                            <span t-esc="doc.manual_cracked_kg"/> Kg
                        </td>
                    </tr>
                </table>

                <div class="row mt-4">
                    <div class="col-6 offset-6 text-center">
                        <p class="mb-5">&nbsp;</p>
                        <p>_________________________</p>
                        <p><strong>RMP Employee</strong></p>
                        <p t-esc="doc.rmp_employee_id.name or ''"/>
                    </div>
                </div>

                <p class="mt-5 text-muted text-center small">
                    This document was generated automatically by Odoo
                </p>
            </div>
        </template>
    </data>
</odoo>