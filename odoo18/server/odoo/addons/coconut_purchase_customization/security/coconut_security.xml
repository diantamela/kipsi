<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record rules for Coconut Supplier Receipt -->

    <!-- Rule: Coconut Supplier Receipt - User access -->
    <record id="coconut_supplier_receipt_rule_user" model="ir.rule">
        <field name="name">Coconut Supplier Receipt: User access (own company)</field>
        <field name="model_id" ref="model_coconut_supplier_receipt"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <!-- Rule: Coconut Supplier Receipt - Manager full access -->
    <record id="coconut_supplier_receipt_rule_manager" model="ir.rule">
        <field name="name">Coconut Supplier Receipt: Manager full access</field>
        <field name="model_id" ref="model_coconut_supplier_receipt"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
    </record>
</odoo>
