<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add is_coconut_supplier checkbox to partner form -->
    <record id="coconut_res_partner_form_view" model="ir.ui.view">
        <field name="name">res.partner.form.coconut</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_company']/.." position="after">
                <field name="is_coconut_supplier"
                    invisible="not (is_company or parent_id)"
                    attrs="{'invisible': [('is_company', '=', False)]}"/>
            </xpath>
            <!-- Add coconut supplier fields under the sales/purchase fields -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="contact_person"
                    placeholder="Contact person name"
                    attrs="{'invisible': [('is_coconut_supplier', '=', False)]}"/>
                <field name="supplier_phone"
                    placeholder="Supplier phone number"
                    attrs="{'invisible': [('is_coconut_supplier', '=', False)]}"/>
            </xpath>
            <xpath expr="//field[@name='comment']" position="after">
                <field name="supplier_address"
                    placeholder="Supplier address"
                    attrs="{'invisible': [('is_coconut_supplier', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>