<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu items for Coconut Purchase Customization -->

    <!-- Main menu under Purchase app -->
    <menuitem id="menu_coconut_receipt_root"
        name="Coconut Receiving"
        parent="purchase.menu_procurement_management"
        sequence="10"/>

    <!-- Receipt menu -->
    <menuitem id="menu_coconut_supplier_receipt"
        name="Coconut Receipts"
        parent="menu_coconut_receipt_root"
        action="action_coconut_supplier_receipt"
        sequence="10"/>

    <!-- Supplier menu - add coconut suppliers filter -->
    <menuitem id="menu_coconut_suppliers"
        name="Coconut Suppliers"
        parent="menu_coconut_receipt_root"
        sequence="20">
    </menuitem>

    <record id="action_coconut_suppliers" model="ir.actions.act_window">
        <field name="name">Coconut Suppliers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_is_coconut_supplier': 1}</field>
        <field name="domain">[('is_coconut_supplier', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No coconut suppliers yet. Create one!
            </p>
            <p>
                Coconut suppliers are vendors who supply coconuts to PT Coco Murni Prima Jaya.
                Mark a partner as "Coconut Supplier" in their partner form.
            </p>
        </field>
    </record>

    <menuitem id="menu_coconut_supplier_list"
        name="Supplier List"
        parent="menu_coconut_suppliers"
        action="action_coconut_suppliers"
        sequence="10"/>
</odoo>