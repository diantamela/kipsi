<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Restore standard Products menu action that was hijacked -->
    <record id="stock.menu_product_variant_config_stock" model="ir.ui.menu">
        <field name="action" ref="stock.product_template_action_product"/>
    </record>

    <record id="product_template_inventory_kanban_view" model="ir.ui.view">
        <field name="name">product.template.inventory.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <!-- Optional: Ensure it runs after stock module so we can override any stock modifications by setting higher priority -->
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Inject our fields -->
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="inventory_card_type"/>
                <field name="qty_available"/>
                <field name="uom_id"/>
                <field name="inventory_status_label"/>
                <field name="wip_production_stage"/>
                <field name="wip_work_center"/>
                <field name="wip_process_status"/>
                <field name="wip_last_processed"/>
                <field name="fg_location_name"/>
                <field name="fg_last_in"/>
                <field name="reject_qty"/>
                <field name="reject_location_name"/>
                <field name="reject_handling_status"/>
                <field name="reject_last_recorded"/>
                <field name="byproduct_location_name"/>
            </xpath>

            <!-- Replace the standard card content -->
            <xpath expr="//t[@t-name='card']" position="replace">
                <t t-name="card" class="flex-column custom_inventory_card_container">
                    <!-- Base class for our custom styling -->
                    <div class="custom_inventory_card d-flex flex-column h-100" t-att-data-card-type="record.inventory_card_type.raw_value">
                        <!-- HEADER -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="text-truncate">
                                <strong class="o_kanban_record_title h5 mb-0 d-block text-truncate">
                                    <field name="name"/>
                                </strong>
                                <div t-if="record.default_code.value" class="text-muted small">
                                    [<field name="default_code"/>]
                                </div>
                            </div>
                            <div class="o_dropdown_kanban dropdown">
                                <a role="button" class="dropdown-toggle o-no-caret btn btn-sm btn-link text-muted" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a role="menuitem" type="edit" class="dropdown-item">Lihat Detail</a>
                                    <a role="menuitem" type="object" name="action_open_quants" class="dropdown-item">Lihat Persediaan</a>
                                    <a role="menuitem" type="object" name="action_view_stock_move_lines" class="dropdown-item">Riwayat Pergerakan</a>
                                </div>
                            </div>
                        </div>

                        <!-- BADGE -->
                        <div class="mb-3">
                            <t t-if="record.inventory_card_type.raw_value == 'bahan_baku'">
                                <span class="badge rounded-pill text-bg-success">Bahan Baku</span>
                            </t>
                            <t t-elif="record.inventory_card_type.raw_value == 'wip'">
                                <span class="badge rounded-pill text-bg-warning">Work In Progress</span>
                            </t>
                            <t t-elif="record.inventory_card_type.raw_value == 'fg'">
                                <span class="badge rounded-pill text-bg-info">Produk Jadi</span>
                            </t>
                            <t t-elif="record.inventory_card_type.raw_value == 'reject'">
                                <span class="badge rounded-pill text-bg-danger">Reject</span>
                            </t>
                            <t t-elif="record.inventory_card_type.raw_value == 'byproduct'">
                                <span class="badge rounded-pill" style="background-color: #8B4513; color: white;">Produk Samping</span>
                            </t>
                            <t t-else="">
                                <span class="badge rounded-pill text-bg-secondary"><field name="categ_id"/></span>
                            </t>
                        </div>

                        <!-- BODY - CONDITIONAL -->
                        <div class="o_kanban_record_body flex-grow-1">
                            <!-- Bahan Baku -->
                            <t t-if="record.inventory_card_type.raw_value == 'bahan_baku'">
                                <div class="inventory_metric text-center mb-3">
                                    <div class="fs-1 fw-bold"><field name="qty_available"/> <span class="fs-5 text-muted fw-normal"><field name="uom_id"/></span></div>
                                </div>
                                <div class="d-flex justify-content-between small py-1 border-bottom">
                                    <span class="text-muted"><i class="fa fa-map-marker me-1"/>Lokasi</span>
                                    <strong class="text-end">Gudang Bahan Baku</strong>
                                </div>
                                <div class="d-flex justify-content-between small py-1">
                                    <span class="text-muted"><i class="fa fa-heartbeat me-1"/>Status</span>
                                    <strong t-att-class="record.inventory_status_label.raw_value == 'Habis' ? 'text-danger' : (record.inventory_status_label.raw_value == 'Menipis' ? 'text-warning' : 'text-success')">
                                        <field name="inventory_status_label"/>
                                    </strong>
                                </div>
                            </t>

                            <!-- WIP -->
                            <t t-elif="record.inventory_card_type.raw_value == 'wip'">
                                <div class="inventory_metric text-center mb-3">
                                    <div class="fs-2 fw-bold text-warning"><field name="qty_available"/> <span class="fs-6 text-muted fw-normal"><field name="uom_id"/></span></div>
                                </div>
                                <div class="d-flex justify-content-between small py-1 border-bottom">
                                    <span class="text-muted"><i class="fa fa-cogs me-1"/>Tahap</span>
                                    <strong class="text-end text-truncate" style="max-width: 130px;" t-att-title="record.wip_production_stage.raw_value"><field name="wip_production_stage"/></strong>
                                </div>
                                <div class="d-flex justify-content-between small py-1 border-bottom">
                                    <span class="text-muted"><i class="fa fa-building-o me-1"/>Work Center</span>
                                    <strong class="text-end"><field name="wip_work_center"/></strong>
                                </div>
                                <div class="d-flex justify-content-between small py-1">
                                    <span class="text-muted"><i class="fa fa-spinner me-1"/>Status</span>
                                    <strong class="text-end"><field name="wip_process_status"/></strong>
                                </div>
                            </t>

                            <!-- Produk Jadi -->
                            <t t-elif="record.inventory_card_type.raw_value == 'fg'">
                                <div class="inventory_metric text-center mb-3">
                                    <div class="fs-1 fw-bold text-info"><field name="qty_available"/> <span class="fs-5 text-muted fw-normal"><field name="uom_id"/></span></div>
                                </div>
                                <div class="d-flex justify-content-between small py-1 border-bottom">
                                    <span class="text-muted"><i class="fa fa-map-marker me-1"/>Lokasi FG</span>
                                    <strong class="text-end text-truncate" style="max-width: 130px;"><field name="fg_location_name"/></strong>
                                </div>
                                <div class="d-flex justify-content-between small py-1">
                                    <span class="text-muted"><i class="fa fa-check-circle me-1"/>Ketersediaan</span>
                                    <strong t-att-class="record.inventory_status_label.raw_value == 'Habis' ? 'text-danger' : 'text-success'">
                                        <field name="inventory_status_label"/>
                                    </strong>
                                </div>
                            </t>

                            <!-- Reject -->
                            <t t-elif="record.inventory_card_type.raw_value == 'reject'">
                                <div class="inventory_metric text-center mb-3">
                                    <div class="fs-1 fw-bold text-danger"><field name="reject_qty"/> <span class="fs-5 text-muted fw-normal"><field name="uom_id"/></span></div>
                                </div>
                                <div class="d-flex justify-content-between small py-1 border-bottom">
                                    <span class="text-muted"><i class="fa fa-map-marker me-1"/>Lokasi</span>
                                    <strong class="text-end text-truncate" style="max-width: 130px;"><field name="reject_location_name"/></strong>
                                </div>
                                <div class="d-flex justify-content-between small py-1">
                                    <span class="text-muted"><i class="fa fa-wrench me-1"/>Penanganan</span>
                                    <strong class="text-end"><field name="reject_handling_status"/></strong>
                                </div>
                            </t>

                            <!-- Produk Samping -->
                            <t t-elif="record.inventory_card_type.raw_value == 'byproduct'">
                                <div class="inventory_metric text-center mb-3">
                                    <div class="fs-1 fw-bold" style="color: #8B4513;"><field name="qty_available"/> <span class="fs-5 text-muted fw-normal"><field name="uom_id"/></span></div>
                                </div>
                                <div class="d-flex justify-content-between small py-1 border-bottom">
                                    <span class="text-muted"><i class="fa fa-map-marker me-1"/>Lokasi</span>
                                    <strong class="text-end text-truncate" style="max-width: 130px;"><field name="byproduct_location_name"/></strong>
                                </div>
                                <div class="d-flex justify-content-between small py-1">
                                    <span class="text-muted"><i class="fa fa-heartbeat me-1"/>Status</span>
                                    <strong t-att-class="record.inventory_status_label.raw_value == 'Habis' ? 'text-danger' : 'text-success'">
                                        <field name="inventory_status_label"/>
                                    </strong>
                                </div>
                            </t>

                            <!-- Other -->
                            <t t-else="">
                                <div class="inventory_metric text-center mb-3">
                                    <div class="fs-1 fw-bold"><field name="qty_available"/> <span class="fs-5 text-muted fw-normal"><field name="uom_id"/></span></div>
                                </div>
                                <div class="d-flex justify-content-between small py-1">
                                    <span class="text-muted"><i class="fa fa-info-circle me-1"/>Status</span>
                                    <strong class="text-end"><field name="inventory_status_label"/></strong>
                                </div>
                            </t>
                        </div>

                        <!-- FOOTER -->
                        <div class="o_kanban_record_bottom mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                            <div class="oe_kanban_bottom_left text-muted small">
                                <t t-if="record.inventory_card_type.raw_value == 'wip'">
                                    <i class="fa fa-clock-o me-1"/> <field name="wip_last_processed" widget="date"/>
                                </t>
                                <t t-elif="record.inventory_card_type.raw_value == 'fg'">
                                    <i class="fa fa-clock-o me-1"/> <field name="fg_last_in" widget="date"/>
                                </t>
                                <t t-elif="record.inventory_card_type.raw_value == 'reject'">
                                    <i class="fa fa-clock-o me-1"/> <field name="reject_last_recorded" widget="date"/>
                                </t>
                                <t t-else="">
                                    <i class="fa fa-clock-o me-1"/> <field name="write_date" widget="date"/>
                                </t>
                            </div>
                            
                            <!-- Hover Action Buttons -->
                            <div class="kanban_hover_actions">
                                <button class="btn btn-sm btn-light border o_kanban_action" type="edit" title="Lihat Detail"><i class="fa fa-eye"/></button>
                                <button class="btn btn-sm btn-light border o_kanban_action" type="object" name="action_open_quants" title="Lihat Stok"><i class="fa fa-cubes"/></button>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
