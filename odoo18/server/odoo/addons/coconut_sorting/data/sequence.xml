<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for legacy Coconut Sorting (preserved) -->
        <record id="seq_coconut_sorting" model="ir.sequence">
            <field name="name">Sequence Sortir Kelapa</field>
            <field name="code">coconut.sorting</field>
            <field name="prefix">SORT/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Coconut Manufacturing (new) -->
        <record id="seq_coconut_manufacturing" model="ir.sequence">
            <field name="name">Sequence Manufaktur Kelapa</field>
            <field name="code">coconut.manufacturing</field>
            <field name="prefix">MFG/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
