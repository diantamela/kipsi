<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View - coconut.manufacturing -->
    <record id="view_coconut_manufacturing_form" model="ir.ui.view">
        <field name="name">coconut.manufacturing.form</field>
        <field name="model">coconut.manufacturing</field>
        <field name="arch" type="xml">
            <form string="Pemakaian Kelapa Produksi">
                <header>
                    <button name="action_confirm"
                            id="btn_confirm_mfg"
                            string="Konfirmasi"
                            type="object"
                            invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_validate"
                            id="btn_validate_mfg"
                            string="Validasi &amp; Buat Pergerakan Stok"
                            type="object"
                            invisible="state != 'confirmed'"
                            class="oe_highlight"/>
                    <button name="action_cancel"
                            id="btn_cancel_mfg"
                            string="Batalkan"
                            type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft"
                            id="btn_reset_mfg"
                            string="Kembalikan ke Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <!-- Print PDF action shortcut in the header -->
                    <button name="%(action_report_coconut_manufacturing)d"
                            string="Cetak PDF"
                            type="action"
                            class="btn-secondary"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Header Info -->
                    <group>
                        <group string="Informasi Pemakaian Produksi">
                            <field name="production_date"
                                   readonly="state != 'draft'"/>
                            <field name="responsible_id"
                                   string="Operator / Karyawan"
                                   readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Sumber Kelapa (Opsional)">
                            <field name="receipt_id"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Sumber Penerimaan -->
                        <page string="Sumber Penerimaan" name="tab_sumber" invisible="not receipt_id">
                            <group>
                                <group string="Data Penerimaan">
                                    <field name="receipt_code"
                                           string="Kode Penerimaan"
                                           readonly="1"/>
                                    <field name="supplier_id"
                                           string="Pemasok"
                                           readonly="1"/>
                                    <field name="coconut_origin"
                                           string="Asal Kelapa"
                                           readonly="1"/>
                                    <field name="receipt_date"
                                           string="Tanggal Penerimaan"
                                           readonly="1"/>
                                    <field name="vehicle_number"
                                           string="Nomor Polisi"
                                           readonly="1"/>
                                    <field name="driver_name"
                                           string="Nama Supir"
                                           readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 2: Sheller -->
                        <page string="Sheller" name="tab_sheller">
                            <group string="Machine Sheller (dari Kelapa Layak Produksi)">
                                <group>
                                    <field name="machine_sheller_input"
                                           string="Input Machine Sheller (Kg)"
                                           readonly="state != 'draft'"/>
                                    <field name="machine_sheller_output"
                                           string="Output Machine Sheller (Kg)"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group string="Ketersediaan Kelapa Layak">
                                    <field name="remaining_layak"
                                           string="Sisa Kelapa Layak Setelah Proses Ini (Kg)"
                                           readonly="1"/>
                                </group>
                            </group>
                            <group string="Manual Sheller (dari Kelapa Reject)">
                                <group>
                                    <field name="manual_sheller_input"
                                           string="Input Manual Sheller (Kg)"
                                           readonly="state != 'draft'"/>
                                    <field name="manual_sheller_output"
                                           string="Output Manual Sheller (Kg)"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group string="Ketersediaan Kelapa Reject">
                                    <field name="remaining_reject"
                                           string="Sisa Kelapa Reject Setelah Proses Ini (Kg)"
                                           readonly="1"/>
                                </group>
                            </group>
                            <group string="Ringkasan Sheller">
                                <group>
                                    <field name="total_sheller_input"
                                           string="Total Input Sheller (Kg)"
                                           readonly="1"/>
                                    <field name="total_sheller_output"
                                           string="Total Output Kelapa Sheller (Kg)"
                                           readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 3: Parer -->
                        <page string="Parer" name="tab_parer">
                            <group string="Proses Parer (dari Kelapa Sheller)">
                                <group>
                                    <field name="available_kelapa_sheller"
                                           string="Kelapa Sheller Tersedia (Kg)"
                                           readonly="1"/>
                                    <field name="parer_input"
                                           string="Input Parer (Kg)"
                                           readonly="state != 'draft'"/>
                                    <field name="parer_output"
                                           string="Output Parer / Kelapa Parer (Kg)"
                                           readonly="state != 'draft'"/>
                                    <field name="remaining_kelapa_sheller"
                                           string="Sisa Kelapa Sheller (Kg)"
                                           readonly="1"/>
                                </group>
                            </group>
                            <group string="Catatan Parer">
                                <field name="parer_notes"
                                       nolabel="1"
                                       readonly="state != 'draft'"/>
                            </group>
                        </page>

                        <!-- Tab 4: Pergerakan Stok -->
                        <page string="Pergerakan Stok" name="tab_stok"
                               invisible="not shell_output_move_id and not parer_output_move_id">
                            <group string="Sheller"
                                   invisible="not shell_output_move_id">
                                <field name="shell_consume_layak_move_id"
                                       string="Konsumsi Kelapa Layak (Machine)"
                                       readonly="1"/>
                                <field name="shell_consume_reject_move_id"
                                       string="Konsumsi Kelapa Reject (Manual)"
                                       readonly="1"/>
                                <field name="shell_output_move_id"
                                       string="Produksi Kelapa Sheller"
                                       readonly="1"/>
                            </group>
                            <group string="Parer"
                                   invisible="not parer_output_move_id">
                                <field name="parer_consume_move_id"
                                       string="Konsumsi Kelapa Sheller"
                                       readonly="1"/>
                                <field name="parer_output_move_id"
                                       string="Produksi Kelapa Parer"
                                       readonly="1"/>
                            </group>
                        </page>

                        <!-- Tab 5: Catatan -->
                        <page string="Catatan" name="tab_catatan">
                            <group>
                                <field name="notes"
                                       string="Catatan Produksi"
                                       nolabel="1"
                                       readonly="state == 'done'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List View - coconut.manufacturing -->
    <record id="view_coconut_manufacturing_list" model="ir.ui.view">
        <field name="name">coconut.manufacturing.list</field>
        <field name="model">coconut.manufacturing</field>
        <field name="arch" type="xml">
            <list string="Pemakaian Kelapa Produksi"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'confirmed'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">
                <field name="name" string="Kode Pemakaian"/>
                <field name="production_date" string="Tgl Produksi"/>
                <field name="responsible_id" string="Operator"/>
                <field name="receipt_id" string="Penerimaan"/>
                <field name="total_sheller_input" string="Input Sheller (Kg)" sum="Total Input Sheller"/>
                <field name="total_sheller_output" string="Output Sheller (Kg)" sum="Total Output Sheller"/>
                <field name="parer_input" string="Input Parer (Kg)" sum="Total Input Parer"/>
                <field name="parer_output" string="Output Parer (Kg)" sum="Total Output Parer"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Search View - coconut.manufacturing -->
    <record id="view_coconut_manufacturing_search" model="ir.ui.view">
        <field name="name">coconut.manufacturing.search</field>
        <field name="model">coconut.manufacturing</field>
        <field name="arch" type="xml">
            <search string="Cari Pemakaian Kelapa Produksi">
                <field name="name" string="Kode Pemakaian"/>
                <field name="responsible_id" string="Operator"/>
                <field name="production_date" string="Tanggal Produksi"/>
                <separator/>
                <filter string="Draft"        name="draft"     domain="[('state','=','draft')]"/>
                <filter string="Dikonfirmasi" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Selesai"      name="done"      domain="[('state','=','done')]"/>
                <filter string="Dibatalkan"   name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <!-- Date Filters -->
                <filter string="Tanggal Produksi" name="production_date_filter" date="production_date"/>
                <group expand="0" string="Kelompokkan Berdasarkan">
                    <filter string="Operator"        name="grp_operator" context="{'group_by':'responsible_id'}"/>
                    <filter string="Status"          name="grp_state"    context="{'group_by':'state'}"/>
                    <filter string="Tanggal Produksi" name="grp_production_date" context="{'group_by':'production_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions - coconut.manufacturing -->
    <record id="action_coconut_manufacturing" model="ir.actions.act_window">
        <field name="name">Pemakaian Kelapa Produksi</field>
        <field name="res_model">coconut.manufacturing</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_coconut_manufacturing_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat dokumen Pemakaian Kelapa Produksi baru
            </p>
            <p>
                Dokumen ini mencakup proses Machine/Manual Sheller dan Parer.
            </p>
        </field>
    </record>

    <!-- Action: Draft -->
    <record id="action_coconut_mfg_draft" model="ir.actions.act_window">
        <field name="name">Draft</field>
        <field name="res_model">coconut.manufacturing</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft')]</field>
        <field name="context">{'default_state': 'draft'}</field>
        <field name="search_view_id" ref="view_coconut_manufacturing_search"/>
    </record>

    <!-- Action: Confirmed -->
    <record id="action_coconut_mfg_confirmed" model="ir.actions.act_window">
        <field name="name">Confirmed</field>
        <field name="res_model">coconut.manufacturing</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
        <field name="context">{'default_state': 'confirmed'}</field>
        <field name="search_view_id" ref="view_coconut_manufacturing_search"/>
    </record>

    <!-- Action: Done -->
    <record id="action_coconut_mfg_done" model="ir.actions.act_window">
        <field name="name">Done</field>
        <field name="res_model">coconut.manufacturing</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="context">{'default_state': 'done'}</field>
        <field name="search_view_id" ref="view_coconut_manufacturing_search"/>
    </record>

    <!-- Menus - Pemakaian Kelapa Produksi -->
    <!-- Override / Rename Root Menu from coconut_receiving to Kelapa -->
    <menuitem id="coconut_receiving.menu_coconut_receiving_root"
              name="Kelapa"
              sequence="40"/>

    <!-- Re-parent Penerimaan Kelapa under Kelapa -->
    <menuitem id="coconut_receiving.menu_coconut_receipt"
              name="Penerimaan Kelapa"
              parent="coconut_receiving.menu_coconut_receiving_root"
              sequence="10"/>

    <!-- Enable / Re-parent Sortir Kelapa under Kelapa -->
    <menuitem id="menu_coconut_sorting"
              name="Sortir Kelapa"
              parent="coconut_receiving.menu_coconut_receiving_root"
              action="action_coconut_sorting"
              sequence="20"
              active="True"/>

    <!-- Pemakaian Kelapa Produksi parent folder under Kelapa -->
    <menuitem id="menu_coconut_manufacturing_root"
              name="Pemakaian Kelapa Produksi"
              parent="coconut_receiving.menu_coconut_receiving_root"
              sequence="30"/>

    <!-- Sub-menus under Pemakaian Kelapa Produksi -->
    <menuitem id="menu_coconut_mfg_draft"
              name="Draft"
              parent="menu_coconut_manufacturing_root"
              action="action_coconut_mfg_draft"
              sequence="10"/>

    <menuitem id="menu_coconut_mfg_confirmed"
              name="Confirmed"
              parent="menu_coconut_manufacturing_root"
              action="action_coconut_mfg_confirmed"
              sequence="20"/>

    <menuitem id="menu_coconut_mfg_done"
              name="Done"
              parent="menu_coconut_manufacturing_root"
              action="action_coconut_mfg_done"
              sequence="30"/>

    <menuitem id="menu_coconut_daily_report"
              name="Stok Kelapa Harian"
              parent="coconut_receiving.menu_coconut_receiving_root"
              action="coconut_sorting.action_coconut_daily_stock"
              sequence="40"/>

</odoo>
