<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ═══════════════════════════════════════════════════
             Inherited View: inject Manufacturing & Sorting tabs into coconut.receipt form
             Owned by: coconut_sorting
             ═══════════════════════════════════════════════════ -->
        <record id="view_coconut_receipt_form_sorting_inherit" model="ir.ui.view">
            <field name="name">coconut.receipt.form.sorting</field>
            <field name="model">coconut.receipt</field>
            <field name="inherit_id" ref="coconut_receiving.view_coconut_receipt_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <!-- Manufacturing documents tab -->
                    <page string="Dokumen Manufaktur" name="tab_mfg"
                          invisible="not manufacturing_ids">
                        <group string="Ringkasan Manufaktur">
                            <field name="total_sorting_input_weight"
                                   string="Total Kelapa Diproses (Kg)"
                                   readonly="1"/>
                            <field name="remaining_unsorted_weight"
                                   string="Sisa Kelapa Bulat Belum Diproses (Kg)"
                                   readonly="1"/>
                        </group>
                        <field name="manufacturing_ids" readonly="1">
                            <list string="Dokumen Manufaktur"
                                  decoration-success="state == 'done'"
                                  decoration-warning="state == 'confirmed'"
                                  decoration-muted="state == 'cancelled'">
                                <field name="name" string="Kode"/>
                                <field name="production_date" string="Tgl Produksi"/>
                                <field name="raw_coconut_processed" string="Diproses (Kg)"/>
                                <field name="good_coconut_weight" string="Layak (Kg)"/>
                                <field name="reject_coconut_weight" string="Reject (Kg)"/>
                                <field name="total_sheller_output" string="Sheller (Kg)"/>
                                <field name="parer_output" string="Parer (Kg)"/>
                                <field name="state"
                                       widget="badge"
                                       decoration-success="state == 'done'"
                                       decoration-warning="state == 'confirmed'"
                                       decoration-muted="state == 'cancelled'"/>
                            </list>
                        </field>
                    </page>

                    <!-- Legacy sorting tab (historical data, read-only) -->
                    <page string="Riwayat Sortir (Lama)" name="tab_sort_legacy"
                          invisible="not sorting_ids">
                        <field name="sorting_ids" readonly="1">
                            <list string="Riwayat Sortir Lama"
                                  decoration-success="state == 'done'"
                                  decoration-warning="state == 'confirmed'"
                                  decoration-muted="state == 'cancelled'">
                                <field name="name"/>
                                <field name="date_sorting"/>
                                <field name="input_weight_kg"/>
                                <field name="good_coconut_kg"/>
                                <field name="reject_coconut_kg"/>
                                <field name="loss_kg"/>
                                <field name="state"
                                       widget="badge"
                                       decoration-success="state == 'done'"
                                       decoration-warning="state == 'confirmed'"
                                       decoration-muted="state == 'cancelled'"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════
             Form View – coconut.sorting (LEGACY – read-only access for audit)
             The menu is hidden; this view is only accessible if needed for history.
             ═══════════════════════════════════════════════════ -->
        <record id="view_coconut_sorting_form" model="ir.ui.view">
            <field name="name">coconut.sorting.form</field>
            <field name="model">coconut.sorting</field>
            <field name="arch" type="xml">
                <form string="Sortir Kelapa (Arsip Lama)">
                    <header>
                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="draft,confirmed,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Sumber Penerimaan">
                                <field name="receipt_id" readonly="1"/>
                                <field name="date_sorting" readonly="1"/>
                                <field name="supplier_id" readonly="1"/>
                                <field name="coconut_origin" readonly="1"/>
                                <field name="vehicle_plate" readonly="1"/>
                            </group>
                            <group string="Berat Input Sortir">
                                <field name="input_weight_kg" string="Berat Input (Kg)" readonly="1"/>
                                <field name="remaining_unsorted_weight"
                                       string="Sisa Belum Tersortir (Kg)" readonly="1"/>
                            </group>
                        </group>
                        <group string="Hasil Sortir">
                            <group>
                                <field name="good_coconut_kg" string="Kelapa Layak Produksi (Kg)" readonly="1"/>
                                <field name="reject_coconut_kg" string="Kelapa Reject (Kg)" readonly="1"/>
                                <field name="loss_kg" string="Susut Sortir (Kg)" readonly="1"/>
                            </group>
                            <group>
                                <field name="balance_diff" string="Selisih (Kg)" readonly="1"/>
                                <field name="is_balanced" string="Neraca Seimbang" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" readonly="1"/>
                        </group>
                        <group string="Pergerakan Stok"
                               invisible="not raw_move_id and not good_move_id and not reject_move_id">
                            <field name="raw_move_id" readonly="1"/>
                            <field name="good_move_id" readonly="1"/>
                            <field name="reject_move_id" readonly="1"/>
                            <field name="scrap_id" readonly="1"
                                   invisible="not scrap_id"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════
             List View – coconut.sorting (LEGACY)
             ═══════════════════════════════════════════════════ -->
        <record id="view_coconut_sorting_list" model="ir.ui.view">
            <field name="name">coconut.sorting.list</field>
            <field name="model">coconut.sorting</field>
            <field name="arch" type="xml">
                <list string="Sortir Kelapa (Arsip)"
                      decoration-success="state == 'done'"
                      decoration-warning="state == 'confirmed'"
                      decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="date_sorting"/>
                    <field name="receipt_id"/>
                    <field name="supplier_id"/>
                    <field name="input_weight_kg" string="Input (Kg)"/>
                    <field name="good_coconut_kg" string="Layak (Kg)"/>
                    <field name="reject_coconut_kg" string="Reject (Kg)"/>
                    <field name="loss_kg" string="Susut (Kg)"/>
                    <field name="state"
                           widget="badge"
                           decoration-success="state == 'done'"
                           decoration-warning="state == 'confirmed'"
                           decoration-muted="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════
             Search View – coconut.sorting (LEGACY)
             ═══════════════════════════════════════════════════ -->
        <record id="view_coconut_sorting_search" model="ir.ui.view">
            <field name="name">coconut.sorting.search</field>
            <field name="model">coconut.sorting</field>
            <field name="arch" type="xml">
                <search string="Cari Sortir Kelapa (Arsip)">
                    <field name="name" string="Nomor Sortir"/>
                    <field name="supplier_id" string="Pemasok"/>
                    <field name="receipt_id" string="Penerimaan Kelapa"/>
                    <filter string="Selesai" name="filter_done" domain="[('state', '=', 'done')]"/>
                    <group expand="0" string="Kelompokkan Berdasarkan">
                        <filter string="Pemasok" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                        <filter string="Status"  name="group_state"   context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════
             Action – coconut.sorting (LEGACY, kept for audit access)
             ═══════════════════════════════════════════════════ -->
        <record id="action_coconut_sorting" model="ir.actions.act_window">
            <field name="name">Sortir Kelapa (Arsip Lama)</field>
            <field name="res_model">coconut.sorting</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_coconut_sorting_search"/>
        </record>

        <!-- ═══════════════════════════════════════════════════
             LEGACY MENUS (hidden – preserved so existing XML IDs don't break)
             ═══════════════════════════════════════════════════ -->
        <!-- Old root menu is replaced by the one in coconut_manufacturing_views.xml -->
        <!-- This menu is intentionally inactive to hide from UI -->
        <menuitem id="menu_coconut_receiving_sorting"
                  name="Penerimaan dan Sortir (Arsip)"
                  parent="menu_coconut_manufacturing_root"
                  sequence="90"
                  active="False"/>

        <menuitem id="menu_coconut_sorting"
                  name="Sortir Kelapa (Arsip)"
                  parent="menu_coconut_manufacturing_root"
                  action="action_coconut_sorting"
                  sequence="91"
                  active="False"/>

        <!-- Sub-menu under Manufacturing root: Laporan Stok Harian -->
        <menuitem id="menu_coconut_daily_report"
                  name="Stok Kelapa Harian"
                  parent="menu_coconut_manufacturing_root"
                  action="action_coconut_stock_report"
                  sequence="50"/>

    </data>
</odoo>
